var P4_DATA=
[{"n": 1, "m": 1, "i": "🚗", "t": "الجملة الميكانيكية والوسط الخارجي", "B": [["الجملة الميكانيكية", ["كل جسم أو جزء منه أو مجموعة أجسام نحددها بالنسبة إلى الوسط الخارجي", "مثال: عربة الدراسة: نختار العربة كلها أو العجلة الأمامية فقط"]], ["الوسط الخارجي", ["كل ما هو خارج حدود الجملة الميكانيكية", "يختلف الوسط الخارجي باختلاف الجملة المختارة"]], ["كيف نختار؟", ["حسب ما نريد دراسته: حركة العربة ككل أم حركة العجلة وحدها", "اختيار الجملة مرتبط دائما بالدراسة التي سنجريها"]]], "K": "الجملة الميكانيكية هي ما نختاره لدراسته، وكل ما عداه هو الوسط الخارجي.", "M": ["أحدد ما أدرسه أولا", "أسمّي الجملة بدقة", "أكتب الأجسام المحيطة بها (الوسط الخارجي)"], "X": "نحن من يقرر ما هي الجملة: كأننا نرسم دائرة حول الشيء المدروس، وما يقع خارجها هو الوسط الخارجي الذي يؤثر فيها.", "EX": [["في دراسة حركة عربة، ما الجملة الميكانيكية وما الوسط الخارجي إذا درسنا العربة ككل؟", "الجملة: العربة ككل. الوسط الخارجي: الأرض (السكة) والهواء واليد التي تدفعها"], ["كيف تتغير الجملة إذا درسنا حركة العجلة الأمامية فقط؟", "الجملة تصبح العجلة الأمامية فقط. وصار هيكل العربة والمحور جزءا من الوسط الخارجي"]]}, {"n": 2, "m": 1, "i": "💥", "t": "الفعل الميكانيكي وأنواعه", "B": [["التعريف", ["كل سبب فيزيائي قادر على إحداث أثر في جملة ميكانيكية"]], ["آثاره", ["المحافظة على توازن جملة (تثبيت الخشب قبل قطعه)", "تحريك جملة أو تغيير سرعتها أو مسارها أو توقيفها", "تغيير شكل جملة (ضغط قارورة بلاستيكية)"]], ["حسب التأثير", ["تلامسي: الأجسام متلامسة (جرّ عربة، فعل الأرض على جملة)", "بعدي: الأجسام متباعدة (فعل المغناطيس على برادة الحديد)"]], ["حسب التوزيع", ["موضعي: على نقطة (سحب سيارة معطلة)", "موزّع: على سطح (فعل الهواء على جناح طائرة)"]]], "K": "الفعل الميكانيكي سبب قادر على توازن جملة أو تحريكها أو تغيير شكلها، وقد يكون تلامسيا أو بعديا، موضعيا أو موزعا.", "M": ["أحدد الجملة المؤثِّرة والمتأثِّرة", "أحدد الأثر (حركة أم شكل أم توازن)", "أصنّف الفعل: تلامسي/بعدي وموضعي/موزع"], "X": "كلما رأيت جسما يتحرك أو يتوقف أو يتشوه أو يبقى معلقا، ابحث عن جسم آخر يؤثر فيه: هذا هو الفعل الميكانيكي.", "EX": [["صنّف الفعل الميكانيكي: (أ) جرّ عربة بحبل (ب) فعل مغناطيس على برادة الحديد (ج) فعل الهواء على الشراع.", "أ) تلامسي موضعي (الحبل متصل بنقطة). ب) بعدي. ج) تلامسي موزع على سطح الشراع"], ["بيّن أثر الفعل الميكانيكي في كل حالة: (أ) تثبيت قطعة خشب قبل نشرها (ب) ضغط قارورة بلاستيكية.", "أ) المحافظة على التوازن. ب) تغيير شكل الجملة"]]}, {"n": 3, "m": 1, "i": "➡️", "t": "القوة وتمثيلها بشعاع", "B": [["القوة", ["نمذجة شعاعية لفعل ميكانيكي مطبق بشكل متبادل بين جملتين", "سواء كانتا متلامستين أو متباعدتين"]], ["مميزاتها الأربعة", ["نقطة التأثير", "المنحى (الحامل)", "الجهة", "القيمة (الشدة)"]], ["الرمز والقياس", ["رمز القوة `→F_{A/B}`: قوة الجملة A على الجملة B", "تقاس شدتها بالربيعة (الدينامومتر) ووحدتها النيوتن (N)"]], ["التمثيل بشعاع", ["المبدأ: نقطة التأثير", "المنحى: الخط الحامل", "الجهة: جهة القوة", "الطويلة: متناسبة مع الشدة بسلّم مناسب"]]], "K": "القوة مقدار شعاعي له 4 مميزات: نقطة التأثير والمنحى والجهة والقيمة، وتقاس بالربيعة بالنيوتن.", "M": ["أحدد المؤثِّرة والمتأثِّرة", "أكتب رمز القوة `→F_{A/B}`", "أختار سلّما (مثلا 1 cm ↔ 1 N)", "أرسم الشعاع من نقطة التأثير"], "X": "القوة سهم: بدايته مكان التأثير، واتجاهه جهة الدفع أو الجرّ، وطوله يدل على قوة الفعل. وانتبه: `→F` (بشعاع) تعني القوة بمميزاتها الأربعة، أما F (بدون شعاع) فتعني الشدة فقط.", "EX": [["مثّل بشعاع القوة التي يؤثر بها حبل على مكعب خشبي قيمتها 3 N، أفقية نحو اليمين، بسلّم 1 cm ↔ 1 N.", "نختار نقطة تأثير الحبل على المكعب. نرسم من هذه النقطة شعاعا أفقيا نحو اليمين طوله `3 × 1 = 3` cm. نكتب قربه `→F` (حبل/مكعب)"], ["لماذا لا نكتب `F = 3,2 N` بالشعاع؟ وماذا نكتب؟", "F بدون شعاع هي الشدة فقط: نكتب `F = 3,2 N`. ولا نكتب `→F = 3,2 N` لأن الشعاع له أربعة مميزات وليس قيمة فقط"]]}, {"n": 4, "m": 1, "i": "↔️", "t": "مبدأ الفعلين المتبادلين", "B": [["النص", ["عندما تؤثر جملة A في جملة B بقوة، فإن B تؤثر في A بقوة أيضا", "التأثيران متزامنان (آنيان)"]], ["العلاقة", ["`→F_{A/B} = -→F_{B/A}`"]], ["خواص القوتين", ["نفس الشدة (القيمة) ونفس الحامل (المنحى)", "جهتان متعاكستان"]], ["ملاحظة", ["القوتان تؤثران في جسمين مختلفين فلا تتعادلان", "صحيح مهما كانت الحالة الحركية: ساكنة أو متحركة"]]], "K": "→F(A/B) = −→F(B/A): نفس الشدة ونفس الحامل وجهتان متعاكستان، وتؤثران في آن واحد.", "M": ["أحدد الجملتين A وB", "أرسم مخطط الأجسام المتأثرة", "أمثل القوتين بشعاعين متعاكسين"], "X": "إذا دفعتَ الحائط بيدك فالحائط يدفع يدك بالقوة نفسها في الجهة المعاكسة. لا فعل بدون ردّ فعل.", "EX": [["المغناطيس الأول يجذب الثاني بقوة شدتها 2 N. ما مميزات القوة التي يؤثر بها الثاني على الأول؟", "الشدة 2 N (نفس القيمة). نفس الحامل (الخط الذي يصل المغناطيسين). الجهة معاكسة (نحو المغناطيس الثاني). نقطة التأثير على المغناطيس الأول"], ["عند النزول من قارب إلى الشاطئ ندفع القارب بأرجلنا نحو الخلف. لماذا نميل للسقوط إذا لم نثبّت القارب؟", "الشخص يدفع القارب للخلف، فيدفعه القارب للأمام بقوة مساوية له ومعاكسة (مبدأ الفعلين المتبادلين). وإذا لم يُثبَّت القارب فإنه يتحرك للخلف ويختل توازن الشخص"]]}, {"n": 5, "m": 1, "i": "⚖️", "t": "الثقل والكتلة", "B": [["الثقل `→P`", ["قوة جذب الأرض لكل جملة ميكانيكية: `→P = →F_{T/S}`", "يتغير بتغير المكان لأنه ناتج عن الجاذبية"]], ["مميزات شعاع الثقل", ["المبدأ: مركز ثقل الجملة G", "الجهة: نحو مركز الأرض", "المنحى: شاقولي", "القيمة: `P = m × g`"]], ["العلاقة", ["`P = m × g` حيث P بالنيوتن وm بالكيلوغرام وg بـ N/kg", "`g = 9,81 N/kg` على الأرض"]], ["قيم g", ["القطبان: `9,83 N/kg`", "خط الاستواء: `9,78 N/kg`", "القمر: أقل بست مرات من الأرض"]]], "K": "P = m × g. الكتلة مقدار سلّمي ثابت يقاس بالميزان (kg)، والثقل مقدار شعاعي يتغير بالمكان ويقاس بالربيعة (N).", "M": ["أحوّل الكتلة إلى kg أولا", "أطبق `P = m × g`", "أمثل الثقل شاقوليا نحو الأسفل من G"], "X": "الكتلة هي كمية المادة في الجسم ولا تتغير بتغير المكان، أما الثقل فهو قوة جذب الأرض (أو القمر) لهذا الجسم فيتغير بتغير الجاذبية.", "EX": [["جسم كتلته 10 kg، ثقله في المكان A يساوي 97,8 N. ما قيمة الجاذبية الأرضية في A؟ وما كتلة جسم ثقله 82,5 N في A؟", "`g = P/m = 97,8/10 = 9,78 N/kg`. `m = P/g = 82,5/9,78 ≈ 8,44 kg`"], ["رائد فضاء كتلته بلباسه 130 kg. احسب ثقله على الأرض (`g = 9,81`) وعلى القمر (جاذبيته أقل بست مرات). ما كتلته على القمر؟", "على الأرض: `P = 130 × 9,81 = 1275,3 N`. على القمر: `g' = 9,81/6 = 1,635 N/kg` إذن `P' = 130 × 1,635 ≈ 212,6 N`. الكتلة ثابتة: 130 kg"], ["جسم كتلته 300 g. احسب ثقله وطول شعاعه بسلّم `1 cm ↔ 1,5 N` (`g = 9,81`).", "`m = 0,3 kg`. `P = 0,3 × 9,81 = 2,943 N ≈ 2,94 N`. الطول `2,943 ÷ 1,5 ≈ 1,96 cm`"]]}, {"n": 6, "m": 1, "i": "📋", "t": "مخطط الأجسام المتأثرة", "B": [["الخطوة 1", ["نختار الجسم المدروس ونحدد الأجسام المحيطة به (المحيط الخارجي)"]], ["الخطوة 2", ["نرسم فقاعة لكل جسم ونكتب اسمه، ونرسم خطا تحت اسم الجسم المدروس"]], ["الخطوة 3", ["الفعل التلامسي: سهم مزدوج بخط مستمر", "الفعل البعدي: سهم مزدوج بخط متقطع"]], ["الخطوة 4", ["نكتب فوق السهم وتحته رمز الفعلين، مثل `A/B` و`B/A`"]]], "K": "نرسم فقاعة لكل جسم ونربطها بسهم مزدوج: مستمر للتلامسي ومتقطع للبعدي، ونكتب رمزي الفعلين.", "M": ["أحصي الأجسام المؤثرة", "أميز التلامسي من البعدي", "أكتب رمزا واضحا للفعلين"], "X": "هو خريطة بسيطة تبين من يؤثر في من: كل جسم فقاعة، وكل تأثير سهم مزدوج.", "EX": [["ارسم مخطط الأجسام المتأثرة لقارب شراعي يتحرك على الماء (الهواء والماء والأرض).", "فقاعة للقارب في الوسط. فقاعة للماء: سهم مزدوج مستمر (تلامسي). فقاعة للهواء: سهم مزدوج مستمر (فعل الهواء على الشراع). فقاعة للأرض: سهم مزدوج متقطع (فعل الأرض البعدي: الثقل). مع كتابة الرموز مثل الماء/القارب والقارب/الماء"], ["كيف نمثل فعل الأرض على جسم موضوع على طاولة؟", "فعل الأرض على الجسم بعدي (الثقل): سهم متقطع. وفعل الطاولة على الجسم تلامسي: سهم مستمر"]]}, {"n": 7, "m": 1, "i": "🪢", "t": "توازن جسم خاضع لقوتين", "B": [["وضعية توازن", ["حالة استقرار (سكون أو حركة) ناتجة عن تأثير قوى يبطل بعضها بعضا"]], ["الشرط الأول", ["القوتان متساويتان في القيمة ومتعاكستان في الجهة"]], ["الشرط الثاني", ["لهما نفس المنحى (نفس الحامل)"]], ["العلاقة", ["`→F_{1} + →F_{2} = 0`"]]], "K": "جسم خاضع لقوتين في توازن إذا كانتا متساويتين شدة ولهما نفس الحامل وجهتان متعاكستان: F1 + F2 = 0.", "M": ["أسمّي القوتين المؤثرتين", "أتحقق من تساوي الشدتين", "أتحقق من تطابق الحاملين"], "X": "الجسم يبقى ساكنا إذا شدّه شخصان بالقوة نفسها في جهتين متعاكستين على الخط نفسه.", "EX": [["إطار معلّق بحبل شاقولي ساكن. ما القوتان المؤثرتان عليه؟ وكيف تتعادلان؟", "القوتان: ثقل الإطار `→P` (نحو الأسفل) وقوة الحبل `→F` (نحو الأعلى). لهما نفس الحامل الشاقولي ونفس الشدة وجهتان متعاكستان: `→P + →F = 0`"], ["جسم S كتلته مهملة خاضع لتأثير ربيعتين D1 وD2، وتشير D2 إلى 4 N وهو في توازن. ما مميزات قوة D1؟", "الجسم خاضع لقوتين فهما متساويتان متعاكستان: شدة D1 تساوي 4 N، لها نفس الحامل (الأفقي)، وجهتها معاكسة لقوة D2"]]}, {"n": 8, "m": 1, "i": "🔺", "t": "توازن جسم خاضع لثلاث قوى غير متوازية", "B": [["مثال", ["ثريا معلقة بخيطين مائلين، أو حبة طماطم على ساق مائل"]], ["الشرط 1", ["محصلة القوى الثلاث معدومة: `→F_{1} + →F_{2} + →F_{3} = 0`"]], ["الشرط 2", ["حوامل القوى الثلاث تقع في مستوٍ واحد وتتلاقى في نقطة واحدة"]], ["الرسم", ["المضلع المغلق: إذا وضعنا الأشعة الثلاثة الواحد بعد الآخر عاد آخرها إلى بداية الأول"]]], "K": "ثلاث قوى غير متوازية: المحصلة معدومة والحوامل متلاقية في نقطة واحدة وفي مستوٍ واحد.", "M": ["أحدد القوى الثلاث وأمثلها", "أتحقق أن حواملها تتلاقى في نقطة", "أكتب `→F_{1}+→F_{2}+→F_{3}=0`"], "X": "عندما لا تكون القوى متوازية نرسمها أسهما على التتابع فتشكل مثلثا مغلقا إذا كان الجسم متوازنا.", "EX": [["ثريا ثقلها `P = 5 N` معلقة بخيطين متماثلين. ما شرطا توازنها؟", "القوى الثلاث: ثقل الثريا وقوتا الخيطين. الشرط الأول: `→F_{1} + →F_{2} + →P = 0`. الشرط الثاني: حوامل القوى الثلاث تتلاقى في نقطة واحدة (هي نقطة تعليق الثريا) وتقع في مستوٍ واحد"], ["لماذا نقول إن `→F_{1} + →F_{2}` تساوي قوة شدتها 5 N نحو الأعلى في مثال الثريا؟", "لأن محصلة القوى الثلاث معدومة: `→F_{1} + →F_{2} = -→P`. إذن لها شدة الثقل (5 N) وجهتها نحو الأعلى"]]}, {"n": 9, "m": 1, "i": "➕", "t": "محصلة قوتين", "B": [["التعريف", ["قوة وحيدة رمزها `→R` لها تأثير مساوٍ لمجموع تأثير قوتين على جملة"]], ["كيف نحصل عليها؟", ["مجموع شعاعي للقوتين: `→R = →F_{1} + →F_{2}`", "نرسم قاعدة متوازي الأضلاع أو الأشعة بالتتابع"]], ["لهما نفس الجهة والمبدأ", ["الشدة `R = F_{1} + F_{2}` وجهتها نفس الجهة"]], ["متعاكستان", ["الشدة `R = |F_{1} - F_{2}|` وجهتها جهة القوة الأكبر"]]], "K": "المحصلة هي المجموع الشعاعي للقوتين: شدتاهما تُجمعان إذا اتحدت الجهة وتُطرحان إذا تعاكستا.", "M": ["أرسم القوتين من نفس المبدأ", "أنشئ متوازي الأضلاع", "أقيس طويلة القطر وأحولها إلى نيوتن بالسلّم"], "X": "المحصلة قوة واحدة تعطي نفس الأثر الذي تعطيه القوتان معا. في حالتين خاصتين يكفي الجمع أو الطرح.", "EX": [["`→F_{1}` و`→F_{2}` لهما نفس الجهة ونفس المبدأ، شدتاهما 12 N و6 N. ما محصلتهما؟", "نفس الجهة: `R = 12 + 6 = 18 N` ولها نفس الجهة والمنحى"], ["نفس السؤال إذا كانتا متعاكستين في الجهة وفي المبدأ نفسه.", "متعاكستان: `R = 12 - 6 = 6 N` وجهتها جهة القوة الأكبر (12 N)"], ["`→F_{1}` و`→F_{2}` لهما المبدأ نفسه، شدتاهما 4 N و6 N وبينهما زاوية 30°. أوجد المحصلة بيانيا.", "نختار السلّم `1 cm ↔ 1 N`. نرسم القوتين بينهما 30° ثم نكمل متوازي الأضلاع. المحصلة هي قطره من المبدأ، وطوله حوالي 9,7 cm. إذن `R ≈ 9,7 N`"]]}, {"n": 10, "m": 1, "i": "📐", "t": "تحليل قوة إلى مركبتين", "B": [["المعنى", ["نحلل شعاع القوة إلى مركبتين على حاملين يشكلان معلما متعامدا ومتجانسا"]], ["المركبتان", ["القوة الأصلية هي محصلة المركبتين `→F = →F_{x} + →F_{y}`"]], ["مثال: مستوٍ مائل", ["نحلل ثقل الجسم `→P` إلى `→P_{x}` (موازية للمستوي) و`→P_{y}` (عمودية عليه)"]], ["العلاقة", ["`P_{x} = P × sin α` و`P_{y} = P × cos α` (α زاوية ميل المستوي)"]]], "K": "تحليل القوة عكس التركيب: نستبدل القوة بمركبتين متعامدتين مجموعهما يساوي القوة الأصلية.", "M": ["أختار محورين مناسبين", "أرسم متوازي أضلاع (مستطيل) قطره القوة", "أقرأ المركبتين من الرسم"], "X": "نفكك قوة واحدة مائلة إلى قوتين: واحدة على كل محور، فيسهل علينا دراسة التوازن على كل محور على حدة.", "EX": [["جسم كتلته 1,5 kg على مستوٍ مائل بزاوية 30° وخيط يشدّه. احسب ثقله ومركبته الموازية للمستوي (`g = 9,81`).", "`P = 1,5 × 9,81 = 14,7 N`. `P_{x} = P × sin 30° = 14,7 × 0,5 ≈ 7,4 N`"], ["في التجربة السابقة قيس توتر الخيط `T = 5,0 N`. هل يوجد احتكاك؟ علّل.", "لو لم يوجد احتكاك لكان `T = P_{x} ≈ 7,4 N` عند التوازن. لكن `T = 5,0 N` أصغر، فالفرق حوالي 2,4 N يعوّضه احتكاك المستوي. إذن يوجد احتكاك"]]}, {"n": 11, "m": 1, "i": "🌊", "t": "دافعة أرخميدس وخصائصها", "B": [["التعريف", ["قوة تلامسية موزعة يؤثر بها سائل على جسم مغمور فيه جزئيا أو كليا", "لا يذوب فيه ولا يتفاعل معه"]], ["الرمز", ["`→F_{A}` ووحدتها النيوتن N"]], ["نقطة التأثير والمنحى", ["نقطة التأثير: المركز الهندسي للجزء المغمور (مركز ثقل السائل المزاح)", "المنحى شاقولي"]], ["الجهة والشدة", ["الجهة: من الأسفل نحو الأعلى", "الشدة: تساوي ثقل السائل المزاح"]]], "K": "دافعة أرخميدس قوة شاقولية نحو الأعلى، شدتها تساوي ثقل السائل المزاح.", "M": ["أحدد الجزء المغمور", "أرسم الدافعة من مركزه نحو الأعلى", "أقارنها بالثقل"], "X": "السائل يدفع الجسم المغمور نحو الأعلى، ولهذا يبدو الجسم أخف داخل الماء.", "EX": [["قطعة خشب في الماء تطفو. ما القوى المؤثرة عليها وما اتجاهها؟", "القوتان: ثقل القطعة `→P` (شاقولي نحو الأسفل) ودافعة أرخميدس `→F_{A}` (شاقولية نحو الأعلى). عند الطفو متساويتان في الشدة"], ["أين تنطبق نقطة تأثير دافعة أرخميدس على كرة مغمورة كليا؟", "على المركز الهندسي للكرة (مركز الجزء المغمور وهو الكرة كلها)"]]}, {"n": 12, "m": 1, "i": "🧲", "t": "قياس شدة دافعة أرخميدس: الثقل الظاهري", "B": [["الثقل الحقيقي P", ["ثقل الجسم وهو غير مغمور (معلّق بالربيعة)"]], ["الثقل الظاهري P'", ["القيمة التي تشير إليها الربيعة والجسم مغمور في السائل"]], ["النتيجة", ["P' أصغر من P: نقصان القيمة دليل على قوة نحو الأعلى هي دافعة أرخميدس"]], ["العلاقة", ["`F_{A} = P - P'`"]]], "K": "F_A = P − P′: شدة الدافعة تساوي الفرق بين الثقل الحقيقي والثقل الظاهري.", "M": ["أقرأ P والجسم في الهواء", "أقرأ P' والجسم مغمور", "أحسب الفرق"], "X": "عندما نغمر الجسم تنقص قراءة الربيعة، ونقصان القراءة هو بالضبط شدة دافعة أرخميدس.", "EX": [["جسم ثقله في الهواء 4,41 N. عند غمره كليا في الماء تشير الربيعة إلى 2,78 N. احسب شدة دافعة أرخميدس.", "`F_{A} = P - P' = 4,41 - 2,78 = 1,63 N`"], ["لماذا يكون الثقل الظاهري أصغر من الثقل الحقيقي؟", "لأن الدافعة (نحو الأعلى) تنقص من القوة التي تشدّ الربيعة نحو الأسفل: `P' = P - F_{A}`"]]}, {"n": 13, "m": 1, "i": "🧮", "t": "حساب الدافعة: ثقل السائل المزاح", "B": [["السائل المزاح", ["عند غمر جسم في سائل يزيح حجما V من السائل مساويا لحجمه المغمور"]], ["العلاقة", ["`F_{A} = P_{l}` (ثقل السائل المزاح)", "`P_{l} = m_{l} × g` و`m_{l} = ρ_{l} × V_{l}`"]], ["القانون", ["`F_{A} = ρ_{l} × V_{l} × g`"]], ["الوحدات", ["ρ بـ kg/m³، V بـ m³، g بـ N/kg، والدافعة بـ N", "`1 L = 10^{-3} m^{3}` و`1 dm^{3} = 1 L`"]]], "K": "F_A = ρ × V × g: الكتلة الحجمية للسائل × حجمه المزاح × الجاذبية.", "M": ["أحوّل الحجم إلى m³", "أستعمل كتلة السائل الحجمية (الماء 1000 kg/m³)", "أطبق `F_{A} = ρ × V × g`"], "X": "الدافعة تساوي وزن الماء الذي أزاحه الجسم، فكلما كان الجسم أكبر حجما أو السائل أكثف زادت الدافعة.", "EX": [["قطعة معدنية كتلتها 450 g وحجمها 0,167 dm³ معلقة بربيعة ومغمورة كليا في الماء. احسب شدة الدافعة والثقل الظاهري (`ρ = 1000 kg/m³` و`g = 9,81`).", "`V = 0,167 dm^{3} = 1,67×10^{-4} m^{3}`. `F_{A} = 1000 × 1,67×10^{-4} × 9,81 ≈ 1,64 N`. `P = 0,45 × 9,81 ≈ 4,41 N`. `P' = P - F_{A} ≈ 2,78 N`"], ["سبيكة معدنية متجانسة ثقلها في الهواء 380 N ومغمورة كليا في الماء 320 N. احسب حجمها وكتلتها الحجمية.", "`F_{A} = 380 - 320 = 60 N`. `V = F_{A}/(ρ × g) = 60/(1000 × 9,81) ≈ 6,12×10^{-3} m^{3} = 6,12 L`. `m = P/g = 380/9,81 ≈ 38,7 kg`. `ρ = m/V ≈ 6333 kg/m^{3}`"], ["مكعب ثقله 310 N يصبح ثقله 210 N عند غمره كليا في كحول كتلته الحجمية 806 kg/m³. احسب F_A وحجمه وكتلته الحجمية.", "`F_{A} = 310 - 210 = 100 N`. `V = 100/(806 × 9,81) ≈ 1,265×10^{-2} m^{3} = 12,65 L`. `m = 310/9,81 ≈ 31,6 kg`. `ρ = m/V ≈ 2500 kg/m^{3}`"]]}, {"n": 14, "m": 1, "i": "🔬", "t": "العوامل المؤثرة في الدافعة", "B": [["كثافة السائل", ["كلما كان السائل أكثف زادت شدة الدافعة"]], ["حجم الجزء المغمور", ["كلما كبر الحجم المغمور زاد حجم السائل المزاح فتزداد الدافعة"]], ["لا تتأثر بـ", ["شكل الجسم", "كتلة الجسم وكثافة مادته", "عمق الغمر (ما دام مغمورا كليا)"]], ["تجارب", ["جسمان مختلفا الكثافة ومتساويا الحجم: نفس الدافعة", "حجمان مختلفان في نفس السائل: دافعتان مختلفتان"]]], "K": "الدافعة تتعلق بكثافة السائل وبحجم الجزء المغمور فقط.", "M": ["أقارن السوائل المستعملة", "أقارن حجمي الجسمين", "أتجاهل الكتلة والشكل"], "X": "القانون F = ρ·V·g فيه ρ السائل وV المغمور فقط، ولا يدخل فيه شيء من مادة الجسم.", "EX": [["جسمان من الحديد والخشب لهما نفس الحجم مغموران كليا في الماء. أيهما دافعته أكبر؟", "متساويتان: الدافعة تتعلق بحجم الجزء المغمور وكثافة السائل وليس بنوع مادة الجسم"], ["نفس الجسم يُغمر في الماء ثم في ماء مالح. في أي سائل تكون الدافعة أكبر؟", "في الماء المالح لأن كثافته أكبر: `F_{A} = ρ × V × g`"]]}, {"n": 15, "m": 1, "i": "🥚", "t": "شرط توازن جسم في سائل (الطفو والغوص)", "B": [["الحالة 1: يطفو", ["`F_{A} > P_{c}` فيكون `ρ_{l} > ρ_{c}` أي `d_{l} > d_{c}`"]], ["الحالة 2: عالق", ["`F_{A} = P_{c}` فيكون `ρ_{l} = ρ_{c}` أي `d_{l} = d_{c}`"]], ["الحالة 3: يغوص", ["`F_{A} < P_{c}` فيكون `ρ_{l} < ρ_{c}` أي `d_{l} < d_{c}`"]], ["تجربة البيضة", ["في الماء العذب تغوص البيضة", "نضيف الملح فتزيد كثافة الماء فتعلق ثم تطفو"]]], "K": "يطفو الجسم إذا كانت كثافته أصغر من كثافة السائل، ويعلق إذا تساوتا، ويغوص إذا كانت أكبر.", "M": ["أقارن F_A وثقل الجسم P", "أقارن كتلتيهما الحجميتين", "أستنتج الحالة"], "X": "الجسم يطفو إذا ربح الصراع: الدافعة نحو الأعلى أكبر من الثقل نحو الأسفل.", "EX": [["لماذا يطفو مكعب الجليد في الماء؟", "لأن كتلة الجليد الحجمية أصغر من كتلة الماء الحجمية: `ρ_{c} < ρ_{l}` أي `F_{A} > P`. فيطفو"], ["إناء فارغ من الألمنيوم كتلته 100 g يطفو على الماء. احسب حجم الجزء المغمور (`ρ = 1000 kg/m³`).", "الجسم يطفو في توازن: `F_{A} = P`. إذن `ρ × V_{i} × g = m × g` فـ `V_{i} = m/ρ = 0,1/1000 = 10^{-4} m^{3} = 100 cm^{3}`"], ["سفينة كتلتها 1200 طن تطفو في ماء البحر (`ρ = 1030 kg/m³`). ما حجم الجزء المغمور؟", "`F_{A} = P` فـ `V = m/ρ = 1,2×10^{6}/1030 ≈ 1165 m^{3}`"]]}, {"n": 16, "m": 1, "i": "👑", "t": "أرخميدس وقصة تاج الذهب", "B": [["من هو؟", ["الفيلسوف اليوناني أرخميدس (287 - 212 ق م) من مدينة سيراكوز بجزيرة صقلية", "من أبرز علماء الرياضيات والتحليل الهندسي وصمّم آلات بسيطة مثل البكرات"]], ["القصة", ["طلب الملك من صائغ تاجا من الذهب الخالص وأعطاه كمية الذهب اللازمة", "شك الملك أن الصائغ خلط الذهب بمعدن آخر دون أن يتلف التاج"]], ["الاكتشاف", ["لاحظ أرخميدس أثناء استحمامه أن جسمه يتعرض لقوة تدفعه إلى الأعلى", "فصرخ «وجدتها»"]], ["التجربة", ["غمر كتلة من الفضة وكتلة من الذهب وتاج الملك كلها بنفس الكتلة، وجمع الماء المزاح في كل مرة", "وجد أن التاج أزاح ماء أكثر من الذهب الخالص فعرف أن الصائغ غشّ"]]], "K": "أرخميدس اكتشف أن السائل يدفع الجسم المغمور نحو الأعلى بقوة تساوي ثقل السائل المزاح.", "M": ["أقارن الأحجام المزاحة", "الكتلة نفسها وحجم أكبر يعني مادة أخف", "ثقل الماء المزاح هو مقياس الدافعة"], "X": "الفضة أخف من الذهب، فإذا خُلطت به صار حجم التاج أكبر من حجم ذهب خالص بنفس الكتلة، فيزيح ماء أكثر ويتعرض لدافعة أكبر.", "EX": [["لماذا يزيح تاج مغشوش بالفضة ماء أكثر من قطعة ذهب خالص لها نفس الكتلة؟", "الكتلة الحجمية للفضة (10,5 g/cm³) أصغر من الذهب (19,3 g/cm³). لنفس الكتلة، الجسم الأقل كثافة له حجم أكبر. فيزيح ماء أكثر وتكون دافعة أرخميدس عليه أكبر"], ["ما القاعدة التي استنتجها أرخميدس؟", "شدة دافعة أرخميدس تساوي ثقل السائل المزاح: `F_{A} = ρ_{l} × V_{l} × g`"]]}, {"n": 17, "m": 2, "i": "🔌", "t": "التكهرب وطرقه", "B": [["التعريف", ["التكهرب: عملية توليد الشحنات الكهربائية على جسم نتيجة انتقال إلكترونات منه أو إليه"]], ["بالدلك", ["ندلك ماصة بلاستيكية بقطعة فرو أو صوف فتجذب قصاصات الورق", "ندلك قضيب إيبونيت بالفرو، وزجاج بالحرير"]], ["باللمس", ["نلمس بجسم مشحون جسما ناقلا معزولا فيكتسب شحنة من نوع شحنة الجسم المشحون"]], ["بالتأثير", ["نقرّب جسما مشحونا من جسم ناقل معزول دون لمسه فتظهر عليه شحنات (تفاعل عن بعد)"]]], "K": "التكهرب بثلاث طرق: الدلك واللمس والتأثير، وسببه دائما انتقال الإلكترونات.", "M": ["أنظف الأجسام وأجففها", "أدلك الجزء المقصود فقط", "أتأكد من العزل (خيط عازل)", "أختبر الشحنة بكاشف كهربائي"], "X": "بعد الدلك يصبح للجسم قدرة على جذب الأجسام الخفيفة. وكل ما نراه من شرارات ولسعات بعد خلع الملابس الصوفية سببه تكهرب بالدلك.", "EX": [["ماذا يحدث عند تقريب ماصة بلاستيكية مدلوكة بالفرو من قصاصات ورق؟ وماذا نسمي الظاهرة؟", "الماصة تجذب القصاصات: الماصة تكهربت بالدلك فأصبحت مشحونة، والأجسام المشحونة تجذب الأجسام الخفيفة. الظاهرة تسمى التكهرب"], ["قرّبنا ماصة بلاستيكية مشحونة من كاشف كهربائي دون لمسه ثم أبعدناها. ما طريقة التكهرب؟ وماذا نلاحظ؟", "التكهرب بالتأثير. تنفرج ورقتا الكاشف أثناء الاقتراب ثم تنطبقان عند الإبعاد: الشحنات الظاهرة مؤقتة وتزول بزوال التأثير"]]}, {"n": 18, "m": 2, "i": "➕", "t": "نوعا الشحنة والتجاذب والتنافر", "B": [["الشحنة الموجبة (+)", ["تظهر على الجسم عندما يفقد إلكترونات", "مثل قضيب زجاجي مدلوك بالحرير"]], ["الشحنة السالبة (−)", ["تظهر عندما يكتسب الجسم إلكترونات", "مثل البلاستيك أو الإيبونيت المدلوك بالفرو أو الصوف"]], ["التجاذب", ["شحنتان كهربائيتان متعاكستان في الإشارة تتجاذبان", "مثل قضيب بلاستيكي وقضيب زجاجي"]], ["التنافر", ["شحنتان كهربائيتان متماثلتان في الإشارة تتنافران", "مثل قضيبين زجاجيين مدلوكين أو قضيبين من البلاستيك"]]], "K": "الشحنتان المتماثلتان تتنافران والمتعاكستان تتجاذبان، والتأثير متبادل (مبدأ الفعلين المتبادلين).", "M": ["أحدد إشارة الشحنة بتجارب التجاذب والتنافر", "أتذكر: موجب = فقد إلكترونات", "السالب = اكتسب إلكترونات"], "X": "الشحنات المتشابهة تتبعد عن بعضها، والمختلفة تقترب. وكأن كل جسم مشحون يقول للآخر: لو كنا مثلين فابتعد، ولو كنا مختلفين فاقترب.", "EX": [["قضيبان زجاجيان مدلوكان بالحرير يقترب أحدهما من الآخر المعلق بخيط. ماذا يحدث؟ ولماذا؟", "يحدث تنافر: كل منهما فقد إلكترونات فحمل شحنة موجبة، والشحنتان المتماثلتان تتنافران"], ["قضيب بلاستيكي مدلوك بالفرو يقترب من قضيب زجاجي مدلوك بالحرير. ماذا يحدث؟ ولماذا؟", "يحدث تجاذب: البلاستيك اكتسب إلكترونات (شحنة سالبة) والزجاج فقد إلكترونات (شحنة موجبة). المتعاكستان تتجاذبان"]]}, {"n": 19, "m": 2, "i": "🧲", "t": "النواقل والعوازل الكهربائية", "B": [["الناقل", ["جسم تنتقل خلاله الشحنات الكهربائية في الحال", "لوجود إلكترونات حرة الحركة في ذرّاته", "مثل الحديد والنحاس"]], ["العازل", ["جسم لا تنتقل خلاله الشحنات الكهربائية بعد شحنه", "وتبقى متمركزة في موضع الشحن", "مثل الورق الجاف والخشب الجاف والبلاستيك"]], ["تجربة", ["نقرّب قضيبا نحاسيا من كرية نواس ملموسة بقضيب مشحون: تنتقل الشحنة عبره", "بقضيب بلاستيكي لا تنتقل الشحنة"]], ["الأهمية", ["العوازل تحمي من الصعق: غلاف الأسلاك المطاطي", "النواقل تستعمل لنقل التيار: أسلاك النحاس"]]], "K": "الإلكترونات تنتقل في النواقل ولا تنتقل في العوازل.", "M": ["أصنّف المادة: معدن = ناقل", "لشحن ناقل أعزله بحامل عازل", "أستعمل النهاية المدلوكة فقط من القضيب"], "X": "في المعادن إلكترونات حرة تتنقل بسهولة فتنقل الشحنة، أما في العوازل فالإلكترونات مرتبطة بذراتها فلا تتحرك.", "EX": [["صنّف ما يلي إلى ناقل وعازل: قضيب نحاسي، ماصة بلاستيكية، ورق جاف، سلك حديدي.", "نواقل: القضيب النحاسي والسلك الحديدي. عوازل: الماصة البلاستيكية والورق الجاف"], ["لماذا نمسك قضيب الإيبونيت من نهايته غير المدلوكة؟", "لأن الإيبونيت عازل فتبقى الشحنة في الجزء المدلوك ولا تنتقل إلى اليد. أما لو كان ناقلا لانتقلت الشحنة إلى جسمنا"]]}, {"n": 20, "m": 2, "i": "⚛️", "t": "النموذج المبسط للذرة", "B": [["تاريخ النموذج", ["دالتون (1803): كرة مصمتة", "طومسون (1904): كرة موجبة محشوة بالإلكترونات (اكتشف الإلكترون سنة 1897)", "رذرفورد (1912): نواة مركزية موجبة والإلكترونات حولها", "بور (1913): نموذج كوكبي بمدارات محددة"]], ["مكونات الذرة", ["نواة مركزية فيها البروتونات (+) والنيوترونات (متعادلة كهربائيا)", "إلكترونات (−) تدور حول النواة"]], ["اكتشاف النيوترون", ["شادويك سنة 1932: يسمح بالحد من التنافر بين البروتونات"]], ["الأحجام", ["الذرة فراغ كبير: قطرها أكبر بكثير من قطر النواة", "معظم الكتلة في النواة"]]], "K": "الذرة: نواة (بروتونات موجبة + نيوترونات متعادلة) وإلكترونات سالبة تدور حولها.", "M": ["أتذكر الترتيب: دالتون ثم طومسون ثم رذرفورد ثم بور", "النواة موجبة والإلكترونات سالبة", "الذرة متعادلة"], "X": "النموذج المبسط يشبه نظاما شمسيا: النواة كالشمس والإلكترونات كالكواكب. وهو تبسيط يكفي لتفسير التكهرب.", "EX": [["ما مكونات الذرة وما شحنة كل منها؟", "النواة: البروتونات (شحنة موجبة) والنيوترونات (متعادلة). حول النواة: الإلكترونات (شحنة سالبة)"], ["لماذا الذرة متعادلة كهربائيا؟", "لأن قيمة الشحنة الموجبة للنواة تساوي قيمة الشحنة السالبة لمجموع الإلكترونات، فتتعادل"]]}, {"n": 21, "m": 2, "i": "🔢", "t": "الشحنة الكهربائية العنصرية", "B": [["التعريف", ["أبسط وأصغر شحنة يمكن أن تحملها دقيقة، رمزها `e`"]], ["قيمتها", ["`e = 1,6 × 10^{-19} C`", "وحدة الشحنة في النظام الدولي: الكولوم (C)"]], ["الإلكترون والبروتون", ["شحنة الإلكترون: `-e = -1,6 × 10^{-19} C`", "شحنة البروتون: `+e = +1,6 × 10^{-19} C`"]], ["حساب عدد الإلكترونات", ["`N = |q| ÷ e`", "موجب: فقد N إلكترونا، سالب: اكتسب N إلكترونا"]]], "K": "شحنة أي جسم مضاعف صحيح لـ e = 1,6×10⁻¹⁹ C، وعدد الإلكترونات = |q| ÷ e.", "M": ["أقسم القيمة المطلقة للشحنة على e", "أحدد الفقد أو الاكتساب بإشارة q", "أتأكد أن العدد صحيح"], "X": "الشحنة تأتي بحزم صغيرة متساوية، فعدد الحزم التي فقدها الجسم أو اكتسبها هو عدد الإلكترونات.", "EX": [["جسم شحنته `q = +3,2 × 10^{-19} C`. كم إلكترونا فقد أو اكتسب؟", "الشحنة موجبة فهو فقد إلكترونات. `N = 3,2×10^{-19} ÷ 1,6×10^{-19} = 2` إلكترونان"], ["جسم آخر شحنته `q = -4,8 × 10^{-19} C`. كم إلكترونا فقد أو اكتسب؟", "الشحنة سالبة فهو اكتسب إلكترونات. `N = 4,8×10^{-19} ÷ 1,6×10^{-19} = 3` إلكترونات"], ["تطبيق النموذج: ذرة الصوديوم فيها 11 إلكترونا وذرة الكلور 17. ما شحنة نواة كل منهما؟", "الذرة متعادلة: عدد البروتونات = عدد الإلكترونات. نواة الصوديوم: `11 × 1,6×10^{-19} = 1,76×10^{-18} C`. نواة الكلور: `17 × 1,6×10^{-19} = 2,72×10^{-18} C`"]]}, {"n": 22, "m": 2, "i": "🔄", "t": "تفسير ظاهرة التكهرب", "B": [["المبدأ", ["يتم شحن الأجسام بانتقال الإلكترونات", "الذرة تفقد أو تكتسب إلكترونات في الظروف العادية"]], ["الجسم الموجب", ["فقد إلكترونات (مثل الزجاج المدلوك بالحرير)"]], ["الجسم السالب", ["اكتسب إلكترونات (مثل البلاستيك المدلوك بالفرو)"]], ["انحفاظ الشحنة", ["الشحنات التي يفقدها جسم يكتسبها بالضرورة جسم آخر", "فمجموع الشحنات ثابت"]]], "K": "التكهرب انتقال إلكترونات من جسم إلى آخر، والشحنة الكلية محفوظة.", "M": ["أحدد من فقد ومن اكتسب", "أكتب شحنة كل جسم قبل وبعد", "أتحقق أن المجموع ثابت"], "X": "عندما أدلك البلاستيك بالفرو تنتقل إلكترونات من الفرو إلى البلاستيك: البلاستيك صار سالبا والفرو موجبا بنفس القدر.", "EX": [["بعد دلك قضيب مطاطي بقطعة فرو، في أي اتجاه تنتقل الإلكترونات؟ وماذا عن عددي المفقود والمكتسب؟", "من الفرو إلى القضيب. عدد الإلكترونات المفقودة من الفرو يساوي عدد المكتسبة في القضيب (انحفاظ الشحنة)"], ["قربنا جسما موجبا من جسم ناقل معزول متعادل دون لمسه. ماذا يحدث للإلكترونات؟", "تنجذب الإلكترونات الحرة نحو الجسم الموجب فتظهر شحنة سالبة قرب الطرف الأقرب وموجبة على الطرف البعيد (تكهرب بالتأثير). تزول عند إبعاد الجسم"]]}, {"n": 23, "m": 2, "i": "🧲", "t": "التيار الكهربائي المتغير", "B": [["التجربة 1", ["نحرّك مغناطيسا داخل وشيعة موصولة بغلفانومتر: ينحرف المؤشر أثناء الحركة فقط", "ويعود إلى الصفر عند التوقف داخل الوشيعة"]], ["اتجاه الانحراف", ["يتغير الاتجاه عند الدخول والخروج"]], ["التجربة 2", ["ندوّر مغناطيسا أمام وجه الوشيعة: يتحرك المؤشر يمينا ويسارا", "وينعكس عند عكس جهة الدوران"]], ["النتيجة", ["ينتج تيار كهربائي متغير عند تحريك مغناطيس أو دورانه أمام وشيعة ساكنة", "غير ثابت في اتجاهه أو شدته مع الزمن"]]], "K": "تحريك مغناطيس أمام وشيعة (أو دورانه) يولّد تيارا كهربائيا متغيرا.", "M": ["أوصل الوشيعة بالغلفانومتر", "أحرك المغناطيس أو أدوره", "ألاحظ اتجاه وشدة الانحراف"], "X": "الوشيعة لا تعطي تيارا وهي ساكنة بجوار مغناطيس ساكن؛ التيار ينشأ فقط عند الحركة.", "EX": [["ماذا نلاحظ على مؤشر الغلفانومتر عندما ندخل مغناطيسا في وشيعة ثم نتركه ساكنا ثم نسحبه؟", "ينحرف المؤشر في اتجاه أثناء الإدخال، يرجع إلى الصفر عند السكون، وينحرف في الاتجاه المعاكس أثناء السحب"], ["لماذا نسمي التيار الناتج متغيرا؟", "لأنه غير ثابت في الاتجاه (ينعكس) وفي الشدة مع مرور الزمن"]]}, {"n": 24, "m": 2, "i": "🌀", "t": "مبدأ إنتاج التيار المتناوب والمنوّب", "B": [["المبدأ", ["الدوران المنتظم لمغناطيس أمام وجه وشيعة يولّد توترا كهربائيا متناوبا بين طرفي الوشيعة"]], ["التيار المتناوب", ["تيار متغير يمر في دارة في جهتين متعاكستين", "تتغير شدته بين الصفر وقيمتين أعظميتين متعاكستين"]], ["المنوّب", ["جهاز ينتج التيار المتناوب: مغناطيس يدور أمام وشيعة (منوّب الدراجة)"]], ["المنوّب الصناعي", ["كهرومغناطيس يدور أمام وشائع ثابتة في محطات الكهرباء"]]], "K": "المنوّب ينتج التوتر المتناوب بدوران مغناطيس أمام وشيعة.", "M": ["أحدد الجزء الدوّار (المغناطيس)", "والجزء الثابت (الوشيعة)", "كلما زادت سرعة الدوران زاد التواتر والتوتر"], "X": "هو الأساس في توليد الكهرباء في المنازل: دوران منتظم يعطي توترا يعكس جهته بانتظام.", "EX": [["ما مكونا منوّب الدراجة؟ وكيف يضيء المصباح عند تحريك الدراجة؟", "مكوناه: مغناطيس دوّار ووشيعة ثابتة. دوران العجلة يدوّر المغناطيس أمام الوشيعة فينشأ توتر متناوب يضيء المصباح"], ["ماذا يحدث للتوتر إذا زدنا سرعة دوران المغناطيس؟", "يزداد تواتر التوتر (عدد الأدوار في الثانية) وتزداد قيمته"]]}, {"n": 25, "m": 2, "i": "📈", "t": "معاينة التوتر براسم الاهتزاز المهبطي", "B": [["ما يظهر على الشاشة", ["منحنى تغير التوتر U بدلالة الزمن t"]], ["التوتر المستمر", ["خط أفقي مستقيم بقيمة معينة: توتر ثابت"]], ["التوتر المتناوب", ["منحنى متموج منتظم يأخذ قيما موجبة وسالبة (جيبي)"]], ["العلاقات", ["`U_{max} = S_{v} × Y_{max}`", "`T = D × X`"]]], "K": "U_max = الحساسية الشاقولية × سعة المنحنى، T = المسح الأفقي × طول دور كامل (بالتدريجات).", "M": ["أقرأ سعة المنحنى Ymax بالتدريجات", "أقرأ طول الدور X بالتدريجات", "أضرب في الحساسية المناسبة"], "X": "الراسم يرسم لنا التوتر مع الزمن: الارتفاع يعطي التوتر والطول الأفقي يعطي الزمن.", "EX": [["حساسية شاقولية `2 V/div` وسعة المنحنى 3 تدريجات. احسب U_max.", "`U_{max} = S × Y_{max} = 2 × 3 = 6 V`"], ["مسح أفقي `D = 0,1 ms/div` وطول الدور `X = 3,4 div`. احسب الدور والتواتر.", "`T = D × X = 0,1 × 3,4 = 0,34 ms`. `f = 1/T = 1/0,00034 ≈ 2941 Hz`"]]}, {"n": 26, "m": 2, "i": "🌊", "t": "خصائص التوتر المتناوب الجيبي", "B": [["الدور T", ["زمن دور واحد للمنحنى، وحدته الثانية (s)"]], ["التواتر f", ["عدد الأدوار في الثانية الواحدة، وحدته الهرتز (Hz)", "`f = 1/T`"]], ["التوتر الأعظمي والمنتج", ["`U_{max}`: أقصى قيمة يبلغها المنحنى (يقاس براسم الاهتزاز)", "`U_{eff}`: القيمة التي يشير إليها الفولطمتر على وضعية التناوب"]], ["العلاقات", ["`U_{max} / U_{eff} = √2`", "`I_{max} / I_{eff} = √2`"]]], "K": "f = 1/T، وفي التوتر الجيبي: U_max = √2 × U_eff، وكذلك للشدة.", "M": ["أحسب U_max من U_eff بضرب العدد في √2", "أحول ms إلى s قبل حساب f", "الفولطمتر يعطي القيمة المنتجة"], "X": "الفولطمتر والأمبيرمتر يقيسان القيمتين المنتجتين، أما الراسم فيعطي القيمة العظمى.", "EX": [["توتر جيبي قيمته المنتجة 230 V. ما قيمته العظمى؟", "`U_{max} = √2 × U_{eff} = 1,414 × 230 ≈ 325 V`"], ["توتر جيبي دوره 20 ms. ما تواتره؟", "`T = 20 ms = 0,02 s`. `f = 1/0,02 = 50 Hz`"], ["توتر جيبي قيمته العظمى 6 V. ما قيمته المنتجة؟", "`U_{eff} = U_{max}/√2 = 6/1,414 ≈ 4,24 V`"]]}, {"n": 27, "m": 2, "i": "🔌", "t": "مأخذ التيار في القطاع وأسلاكه", "B": [["المأخذ البسيط", ["مربطان: الطور والحيادي فقط"]], ["المأخذ الأرضي", ["ثلاثة مرابط: الطور والحيادي والأرض"]], ["الطور", ["سلك بغلاف أحمر أو بني، موصّل بتيار ذي توتر 220 V", "يسبب الصدمة عند لمسه وحده أو مع الحيادي"]], ["الحيادي والأرضي", ["الحيادي: غلاف أزرق، غير موصّل بتيار", "الأرضي: غلاف أصفر وأخضر، موصّل بالأرض"]]], "K": "الطور (أحمر/بني) خطير، الحيادي (أزرق)، الأرضي (أصفر وأخضر) يحمي من الصعق.", "M": ["أميز الأسلاك بألوانها", "أستعمل مفك كاشف التيار للطور فقط", "لا ألمس الطور أبدا"], "X": "الطور هو السلك الحي: التوتر بينه وبين الحيادي (أو الأرض) حوالي 220 V، بينما التوتر بين الحيادي والأرض يساوي 0 V.", "EX": [["قيس التوتر بين المرابط الثلاثة A وB وC لمأخذ: بين A وB يساوي 230 V، وبين A وC يساوي 0 V، وبين B وC يساوي 230 V. عيّن كل مربط.", "التوتر بين A وC يساوي 0 V فهما الحيادي والأرضي. التوتر بين B وكل من A وC يساوي 230 V فـ B هو الطور"], ["لماذا يضيء مصباح مفك كاشف التيار عند لمس الطور فقط؟", "لأن الطور موصّل بتيار كهربائي ذي توتر عال، فتمرّ شدة صغيرة عبر المفك فيضيء. أما الحيادي فلا يغذي المصباح"]]}, {"n": 28, "m": 2, "i": "⚠️", "t": "أخطار التيار الكهربائي", "B": [["عيوب العزل", ["ارتفاع حرارة الأسلاك وانصهار المادة العازلة وتعرّيها", "فتحدث ملامسة الطور والحيادي (استقصار) أو ملامسة الطور للهيكل المعدني"]], ["زيادة الشدة والحمولة", ["تشغيل عدة أجهزة معا (غسالة، مكيف، تلفاز...) يرفع شدة التيار فوق القيمة المقبولة", "يسبب قطع القاطع أو تلف الأجهزة أو حريقا"]], ["الصدمة الكهربائية", ["الجسم يصبح جزءا من دارة مغلقة والجلد الرطب ناقل جيد", "توتر متناوب أكبر من 25 V في ظروف رطبة قد يكون مميتا"]], ["النتائج", ["حوادث مميتة: تيار متناوب بشدة 40 mA يسبب صعقة قاتلة", "حرائق وتلف الأجهزة"]]], "K": "أخطار التيار: الاستقصار، زيادة الشدة والحمولة، والصعق الكهربائي بملامسة الطور.", "M": ["أتجنب الأسلاك العارية", "لا أشغل عدة أجهزة قوية على مأخذ واحد", "أحافظ على جفاف اليدين"], "X": "الطائر على سلك كهربائي لا يتأذى لأنه يلمس خطا واحدا فلا تُغلق دارة عبر جسمه، لكنه إذا لمس سلكين معا أُغلقت الدارة فمات.", "EX": [["شخص مقاومة جسمه 1000 Ω. ما أكبر توتر يتعرض له دون خطر إذا كان لا يتحمل شدة أكبر من 50 mA؟", "`U = R × I = 1000 × 0,05 = 50 V`"], ["عامل صيانة تعرض لتوتر قيمته العظمى 532 V ومقاومة جسمه 1200 Ω. ما القيمة العظمى للشدة بالمللي أمبير؟", "`I_{max} = U_{max}/R = 532/1200 ≈ 0,443 A ≈ 443 mA`. وهي أكبر بكثير من 40 mA (حد الخطر) فالصعق مميت"]]}, {"n": 29, "m": 2, "i": "🛡️", "t": "وسائل الأمن: التأريض والمنصهرة", "B": [["التوصيل الأرضي", ["نقل التيار المتسرب من الشبكة إلى الأرض لحماية الأشخاص من الصعق"]], ["المنصهرة", ["سلك ينصهر إذا تجاوزت الشدة الحد المسجل عليها فتفتح الدارة"]], ["تركيبها", ["دائما على سلك الطور"]], ["القاطعة", ["تركّب على الطور دائما لتفادي الصعق عند تغيير المصابيح"]]], "K": "التأريض يحمي الأشخاص، والمنصهرة تحمي الدارة من زيادة الشدة، وكلاهما على الطور.", "M": ["أركّب القاطعة والمنصهرة على الطور", "أوصل الأجهزة المعدنية بالأرض", "أستعمل منصهرة مناسبة للشدة"], "X": "الهيكل المعدني المؤرَّض يوصل أي تسرّب كهربائي إلى الأرض بدل أن يمر عبر جسم الإنسان.", "EX": [["لماذا نركّب المنصهرة والقاطعة على سلك الطور؟", "لأن الطور هو السلك الحي: قطعه بالمنصهرة أو القاطعة يعزل الجهاز عن التيار ويحمي الأشخاص عند التدخل"], ["ما دور سلك التأريض في غسالة هيكلها معدني؟", "إذا لامس الطور الهيكل المعدني انتقل التيار إلى الأرض بسلك التأريض فلا تحدث صعقة عند لمس الغسالة"]]}, {"n": 30, "m": 2, "i": "🔒", "t": "القواطع الكهربائية", "B": [["القاطع الرئيسي", ["يركّب بعد العدّاد، حساسيته حوالي 500 mA عادة", "يفصل تلقائيا عند تجاوز الحد وعند خلل خارج الشبكة"]], ["القاطع التفاضلي", ["يقارن شدة التيار في الطور والحيادي", "إذا اختلفتا (تسرب إلى الأرض) فصل التيار آليا", "حساسيته عادة 30 mA"]], ["القاطع التقسيمي (الجزئي)", ["يحمي دارة واحدة من الشدة الزائدة عن الحد", "وقد حل محل المنصهرة في التركيبات الحديثة"]], ["اللوح الكهربائي", ["العناصر الأساسية: القواطع التفاضلية والتقسيمية والمنصهرات"]]], "K": "القاطع التفاضلي (30 mA) يحمي الأشخاص من الصعق، والتقسيمي يحمي كل دارة من زيادة الشدة.", "M": ["التفاضلي لتسرب التيار إلى الأرض", "التقسيمي لزيادة الحمولة", "الرئيسي بعد العدّاد"], "X": "القاطع التفاضلي يعمل كحارس: إن لاحظ أن ما يخرج من الطور لا يساوي ما يعود في الحيادي عرف أن جزءا ذهب إلى الأرض (عبر جسم شخص مثلا) فيقطع التيار.", "EX": [["قاطع تفاضلي حساسيته 30 mA. ماذا يحدث إذا تسرب تيار شدته 40 mA عبر شخص؟", "40 mA أكبر من 30 mA فيقطع القاطع التيار آليا فيحمي الشخص"], ["ما الفرق بين المنصهرة والقاطع التفاضلي؟", "المنصهرة تحمي الدارة من زيادة الشدة بانصهار سلكها (يجب استبدالها). التفاضلي يحمي الأشخاص بقطع التيار عند تسرب إلى الأرض ويعاد تشغيله"]]}, {"n": 31, "m": 2, "i": "🏠", "t": "قواعد الأمن في مخطط شبكة منزلية وحساب الحمولة", "B": [["التركيب", ["خط التوزيع إلى العدّاد: الحيادي موصول بالأرض", "يوصل الطور والحيادي بالعداد ثم بالقاطع التفاضلي"]], ["الخطوط", ["تنطلق خطوط التوزيع من التفاضلي مرورا بلوحة التوزيع", "كل خط محمي بمنصهرة أو قاطع تقسيمي على مربط الطور"]], ["الحمولة", ["`P = U × I` فـ `I = P / U`", "مجموع استطاعات الأجهزة المشغلة معا يحدد الشدة"]], ["التطبيق", ["عند تشغيل أجهزة معا نقارن الشدة المحسوبة بقيمة القاطع"]]], "K": "كل خط محمي على الطور بقاطع تقسيمي، والتفاضلي للحماية العامة، وشدة التيار تحسب من P = U × I.", "M": ["أجمع الاستطاعات", "أحسب `I = P/U`", "أقارن بقيمة المنصهرة أو القاطع"], "X": "الأجهزة القوية تسحب شدة كبيرة؛ فإذا شغلناها كلها معا قد تتجاوز الشدة قيمة القاطع فينقطع التيار.", "EX": [["مطبخ فيه أجهزة استطاعاتها 1200 W و850 W و2000 W و1500 W تعمل معا على 220 V وقاطع 20 A. هل يقطع القاطع التيار؟", "`P = 1200 + 850 + 2000 + 1500 = 5550 W`. `I = P/U = 5550/220 ≈ 25,2 A`. وهي أكبر من 20 A فيقطع القاطع التيار (زيادة الحمولة)"], ["غسالة استطاعتها 4,4 kW على 220 V موصولة بمنصهرة 10 A. هل يمكن تشغيلها بأمان؟", "`I = P/U = 4400/220 = 20 A`. وهي أكبر من 10 A فتنصهر المنصهرة. الحل: تغيير المنصهرة بأخرى مناسبة (أكبر من 20 A) وسلك أسمك وخط خاص بالغسالة"]]}];
