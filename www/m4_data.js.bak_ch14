ه 1 و 3 و 5 و 7. `105=1×105=3×35=5×21=7×15`. القواسم: 1 و 3 و 5 و 7 و 15 و 21 و 35 و 105"], ["عيّن قواسم العدد 84.", "`9^{2}=81<84<10^{2}`. نختبر 1 إلى 9: يقسمه 1 و 2 و 3 و 4 و 6 و 7. الأزواج: `1×84` و `2×42` و `3×28` و `4×21` و `6×14` و `7×12`. القواسم: 1 و 2 و 3 و 4 و 6 و 7 و 12 و 14 و 21 و 28 و 42 و 84"]]}, {"n": 3, "m": 1, "i": "⚙️", "t": "خواص قواسم عدد طبيعي", "B": [["الخاصية 1", ["a و b و n أعداد طبيعية غير معدومة", "إذا كان n يقسم a و b فإنه يقسم `a+b` و `a-b` (حيث `a≥b`)", "وإذا كان n يقسم a فإنه يقسم `k×a` لكل عدد طبيعي k"]], ["الخاصية 2", ["`a>b`", "إذا كان n يقسم a و b فإنه يقسم باقي القسمة الإقليدية لـ a على b"]], ["مثال", ["9 يقسم 90 و 900 فيقسم 810 و 990", "5 يقسم 90 و 25 فيقسم 15 باقي قسمة 90 على 25"]], ["كيف أبرهن «إذا ... فإن ...»؟", ["أفترض صحة الشرط", "أكتب الأعداد بدلالة القاسم `a=n×q`", "أستنتج النتيجة بالتعويض"]]], "K": "إذا قسم n العددين a وb فإنه يقسم مجموعهما وفرقهما وباقي قسمة a على b.", "M": ["لإثبات أن d يقسم m أكتب `m=d×k`", "أستعمل الخاصيتين لتجنب الحسابات الكبيرة", "أكتب المعطيات والمطلوب قبل البرهان"], "X": "إذا كان عدد يقسم عددين فهو يقسم كل ما يُصنع منهما بالجمع والطرح والضرب في عدد، وكذلك باقي القسمة. هذا يعطينا حيلا لتجنب الحسابات الطويلة.", "EX": [["بيّن أن 11 من قواسم 14300. ثم استنتج أن 11 من قواسم 14322.", "`14300=11×1300`. إذن 11 يقسم 14300. `14322=14300+22`. 11 يقسم 14300 ويقسم 22. إذن 11 يقسم المجموع 14322"], ["بيّن أن 7 من قواسم 217. ثم استنتج أن 7 من قواسم 21700000.", "`217=7×31`. إذن 7 يقسم 217. `21700000=217×100000`. فهو مضاعف لـ 217. إذن 7 يقسم 21700000"]]}, {"n": 4, "m": 1, "i": "🤝", "t": "القاسم المشترك الأكبر PGCD", "B": [["القواسم المشتركة", ["القواسم المشتركة لعددين هي القواسم التي تقسمهما معا", "مثال: قواسم 12 هي 1 و 2 و 3 و 4 و 6 و 12 وقواسم 18 هي 1 و 2 و 3 و 6 و 9 و 18", "المشتركة: 1 و 2 و 3 و 6"]], ["التعريف", ["أكبر قاسم مشترك لـ a و b يسمى PGCD(a;b)", "مثال: `PGCD(28;42)=14`", "القواسم المشتركة لعددين هي قواسم PGCD"]], ["نتائج مباشرة", ["`PGCD(a;a)=a` و `PGCD(a;0)=a`", "`PGCD(a;b)=PGCD(b;a)`", "إذا كان b قا