`r`", "أتوقف عندما يكون الباقي 0"]], ["النتيجة", ["PGCD هو آخر باقٍ غير معدوم", "طريقة أسرع من الفروق عندما يكون الفرق كبيرا"]], ["مثال", ["`PGCD(1938;836)`", "`1938=836×2+266`", "`836=266×3+38`", "`266=38×7+0` إذن 38"]]], "K": "كرّر القسمة الإقليدية حتى الباقي 0؛ آخر باقٍ غير معدوم هو PGCD.", "M": ["أكتب كل قسمة بصيغة `a=bq+r`", "المقسوم عليه الجديد هو الباقي السابق", "آخر باقٍ غير معدوم هو الجواب"], "X": "خوارزمية إقليدس أسرع من الفروق لأننا نطرح عدة مرات دفعة واحدة بالقسمة. ننتهي عند الباقي الذي لا يتبعه شيء.", "EX": [["احسب `PGCD(1938;836)` بخوارزمية إقليدس.", "`1938=836×2+266`. `836=266×3+38`. `266=38×7+0`. آخر باقٍ غير معدوم 38. إذن `PGCD(1938;836)=38`"], ["احسب `PGCD(765;135)`.", "`765=135×5+90`. `135=90×1+45`. `90=45×2+0`. آخر باقٍ غير معدوم 45. إذن `PGCD(765;135)=45`"]]}, {"n": 7, "m": 1, "i": "🧩", "t": "العددان الأوليان فيما بينهما", "B": [["التعريف", ["a و b أوليان فيما بينهما يعني `PGCD(a;b)=1`", "أي أن قاسمهما المشترك الوحيد هو 1"]], ["مثال", ["قواسم 22: 1 و 2 و 11 و 22", "قواسم 15: 1 و 3 و 5 و 15", "`PGCD(15;22)=1` فهما أوليان فيما بينهما"]], ["تنبيه", ["الأوليان فيما بينهما لا يلزم أن يكونا أوليين", "مثال: 15 و 22 ليسا أوليين لكنهما أوليان فيما بينهما", "عددان متتاليان دائما أوليان فيما بينهما"]], ["كيف أتحقق؟", ["أحسب PGCD بإقليدس", "إن كان 1 فهما أوليان فيما بينهما"]]], "K": "أوليان فيما بينهما معناه PGCD يساوي 1.", "M": ["أحسب PGCD أولا", "أفرّق بين «أولي» و«أوليان فيما بينهما»", "عدد زوجي وعدد فردي قد يكونان أوليين فيما بينهما"], "X": "عددان لا يتقاسمان إلا العدد 1 يسميان أوليين فيما بينهما، كشخصين لا يشتركان في شيء إلا الوحدة.", "EX": [["هل 143 و 153 أوليان فيما بينهما؟", "`153=143×1+10`. `143=10×14+3`. `10=3×3+1`. `3=1×3+0`. آخر باقٍ غير معدوم 1. إذن `PGCD=1` ونعم هما أوليان فيما بينهما"], ["هل العددان 27 و 36 أوليان فيما بينهما؟", "`PGCD(27;36)=9`. 9 يختلف عن 1. إذن لا، ليسا أوليين فيما بينهما"]]}, {"n": 8, "m": 1, "i": "➗", "t": "الكسور غير القابلة للاختزال", "B": [["التعريف", ["الكسر `a/b` غير قابل للاختزال إذا كان a و b أوليين فيما بينهما", "أي `PGCD(a;b)=1`"]], ["مثال", ["`15/22` غير قابل للاختزال لأن `PGCD(22;15)=1`", "`28/42` قابل للاختزال لأن `PGCD(28;42)=14`", "`28/42=(14×2)/(14×3)=2/3`"]], ["الطريقة", ["أحسب PGCD(a;b)", "أقسم البسط والمقام عليه", "أحصل على كسر غير قابل للاختزال"]], ["ملاحظة", ["القسمة على PGCD تعطي الكسر غير القابل للاختزال مباشرة", "القسمة على قاسم أصغر تحتاج لاختزال آخر"]]], "K": "اقسم البسط والمقام على PGCD فتحصل على الكسر غير القابل للاختزال.", "M": ["أحسب PGCD بخوارزمية إقليدس", "أقسم البسط والمقام عليه", "أتحقق أن الكسر الجديد أولي البسط والمقام"], "X": "اختزال الكسر هو تبسيطه حتى لا يمكن تبسيطه أكثر. نقسم الطرفين على أكبر قاسم مشترك مرة واحدة.", "EX": [["اكتب `595/560` على شكل كسر غير قابل للاختزال.", "`595=560×1+35`. `560=35×16+0`. إذن `PGCD(595;560)=35`. `595/560=(595÷35)/(560÷35)=17/16`"], ["اجعل `915/372` غير قابل للاختزال.", "`915=372×2+171`. `372=171×2+30`. `171=30×5+21`. `30=21×1+9`. `21=9×2+3`. `9=3×3+0`. إذن `PGCD(915;372)=3`. `915/372=305/124`"]]}, {"n": 9, "m": 1, "i": "🏛️", "t": "وضعية إدماجية: ترميم قصر الرياس", "B": [["المعطيات", ["عدد قطع الخزف ≤ 2443", "رقم العشرات = رقم المئات = ضعف رقم الآلاف", "يقبل القسمة على 4 وعلى 8 وعلى 10"]], ["تحليل", ["القسمة على 10 تعني أن رقم الآحاد 0", "رقم الآلاف 1 أو 2 لأن العدد ≤ 2443", "العدد من الشكل `a(2a)(2a)0`"]], ["الحالات", ["`a=1`: العدد 1220", "`a=2`: العدد 2440"]], ["الاختبار", ["`1220÷8=152,5` مرفوض", "`2440÷8=305` و `2440÷4=610` و `2440÷10=244` مقبول"]]], "K": "اكتب شروط الأرقام، ثم اختبر الحالات القليلة بقواعد القسمة.", "M": ["أحدد الشكل العام للعدد", "أحصر الاحتمالات", "أختبر القابلية للقسمة"], "X": "المسألة تطلب عددا يحقق عدة شروط معا. نحوّل كل شرط إلى قيد على الأرقام فتبقى حالتان نختبرهما.", "EX": [["ما عدد القطع الخزفية المطلوب؟", "رقم الآحاد 0 لأن العدد مضاعف لـ 10. الآلاف a: العدد ≤ 2443 فـ `a=1` أو `a=2`. العدد `1220` أو `2440`. `1220÷8=152,5` غير صحيح. `2440÷8=305`. و 2440 يقبل القسمة على 4 وعلى 10. إذن العدد 2440"], ["تحقق من أن العدد 2440 يحقق كل الشروط.", "رقم الآلاف 2 والمئات 4 والعشرات 4 وضعف 2 هو 4. الآحاد 0. `2440≤2443`. `2440=4×610=8×305=10×244`. كل الشروط محققة"]]}, {"n": 10, "m": 2, "i": "√", "t": "الجذر التربيعي لعدد موجب", "B": [["التعريف", ["a عدد موجب", "الجذر التربيعي لـ a هو العدد الموجب الذي مربعه a", "نرمز له `√a`"]], ["أمثلة", ["`√4=2` لأن `2^{2}=4`", "`√25=5` و `√0=0` و `√1=1`", "`√0,04=0,2` لأن `0,2^{2}=0,04`"]], ["خواص (a موجب)", ["`(√a)^{2}=a`", "`√(a^{2})=a`", "`(√5)^{2}=5` و `√(3^{2})=3`"]], ["تنبيه", ["الجذر التربيعي دائما موجب", "`√7` هو العدد الموجب الذي مربعه 7", "`√a` لا معنى له إذا كان a سالبا"]]], "K": "`√a` هو العدد الموجب الذي مربعه a، ولدينا `(√a)²=a` و `√(a²)=a`.", "M": ["لا أقول `√9=±3` بل `√9=3`", "`√(a²)=a` فقط إذا كان a موجبا", "أستعمل المربعات الكاملة المعروفة"], "X": "الجذر التربيعي يعكس عملية التربيع: إذا ربعنا ثم أخذنا الجذر عدنا إلى العدد الموجب.", "EX": [["احسب `1-4b^{2}+√(16b^{4})` (b عدد كيفي).", "`16b^{4}=(4b^{2})^{2}` و `4b^{2}` موجب دائما. إذن `√(16b^{4})=4b^{2}`. `1-4b^{2}+4b^{2}=1`"], ["خزان على شكل متوازي مستطيلات قاعدته مربعة، ارتفاعه 1,80 م وسعته 36 م³. أوجد طول ضلع قاعدته بالتدوير إلى 1 سم.", "مساحة القاعدة `36÷1,8=20` م². الضلع `c=√20≈4,47` م. أي حوالي 447 سم"]]}, {"n": 11, "m": 2, "i": "🔤", "t": "الأعداد الناطقة وغير الناطقة", "B": [["العدد الناطق", ["عدد يكتب على الشكل `a/b` مع a و b صحيحين و `b≠0`"]], ["الجذر وعدد ناطق", ["إذا كان a مربع عدد ناطق فإن `√a` عدد ناطق", "مثال: `25/9=(5/3)^{2}` إذن `√(25/9)=5/3`"]], ["غير الناطق", ["إذا لم يكن a مربع عدد ناطق فإن `√a` ليس ناطقا", "`√6` غير ناطق لأنه لا يوجد ناطق مربعه 6", "`√7` غير ناطق أيضا"]], ["تصنيف", ["ناطقة: `√100` و `√9` و `√0,25` و `√(16/9)`", "غير ناطقة: `√7` و `√13` و `√6` و `√(25/13)`"]]], "K": "`√a` ناطق إذا كان a مربع عدد ناطق، وإلا فهو غير ناطق.", "M": ["أبحث عن مربع كامل", "أحوّل الكسور إلى مربعات كسور", "`√n` غير ناطق إذا لم يكن n مربعا كاملا"], "X": "بعض الجذور أعداد عادية مثل 5/3، وبعضها لا يمكن كتابته ككسر مهما حاولنا مثل جذر 6. نميّز بينهما بمعرفة هل تحت الجذر مربع كامل أم لا.", "EX": [["هل `√169` عدد ناطق؟", "`169=13^{2}`. إذن `√169=13`. هو عدد صحيح فهو ناطق"], ["هل `√(25/13)` ناطق؟", "`25/13` ليس مربع عدد ناطق لأن 13 ليس مربعا كاملا. إذن `√(25/13)` غير ناطق"]]}, {"n": 12, "m": 2, "i": "⚖️", "t": "المعادلات من الشكل x² = a", "B": [["خاصية 1", ["a موجب", "يوجد عددان متعاكسان `√a` و `-√a` مربع كل منهما a"]], ["خاصية 2", ["`a>0`: حلان `√a` و `-√a`", "`a=0`: حل واحد هو 0", "`a<0`: لا حل لأن المربع موجب دائما"]], ["أمثلة", ["`x²=9`: الحلان 3 و -3", "`x²=5`: الحلان `√5` و `-√5`", "`x²=-1`: لا حل"]], ["الطريقة", ["أحدد إشارة a", "إن كان موجبا أكتب `x²=(√a)²`", "أستنتج `x=√a` أو `x=-√a`"]]], "K": "`x²=a`: حلان إن كان a موجبا، حل واحد 0 إن كان a صفرا، ولا حل إن كان سالبا.", "M": ["أنقل الحدود لأحصل على `x²=a`", "لا أنسى الحل السالب", "إذا كان الطرف الثاني سالبا فلا حل"], "X": "مربع أي عدد موجب أو سالب لا يكون سالبا. لذلك المعادلة `x²=9` لها حلان متناظران، وإذا كان الطرف الثاني سالبا فلا حل.", "EX": [["حل `x²=5` و `x²=1/4` و `x²=-9`.", "`x²=5`: `x=√5` أو `x=-√5`. `x²=1/4=(1/2)²`: `x=1/2` أو `x=-1/2`. `x²=-9`: المربع لا يكون سالبا. إذن لا حل"], ["حل `1-9x²=0` و `3+x²=0`.", "`1-9x²=0` تعطي `x²=1/9`. إذن `x=1/3` أو `x=-1/3`. `3+x²=0` تعطي `x²=-3`. لا حل"]]}, {"n": 13, "m": 2, "i": "✖️", "t": "جداء وقسمة الجذور التربيعية", "B": [["خاصية 1", ["a و b موجبان", "`√a×√b=√(a×b)`", "مثال: `√12×√3=√36=6`"]], ["خاصية 2", ["a و b موجبان و `b≠0`", "`√a/√b=√(a/b)`", "مثال: `√60/√15=√4=2`"]], ["ملاحظات", ["`√(a²b)=a√b`", "إذا كان العددان سالبين فـ `√(ab)` موجود لكن `√a` و `√b` لا معنى لهما"]], ["تنبيه مهم", ["`√(a+b)≠√a+√b`", "`√(16+9)=5` لكن `√16+√9=7`", "`√(100-36)=8` لكن `√100-√36=4`"]]], "K": "الجذر يتوافق مع الضرب والقسمة، ولا يتوافق مع الجمع والطرح.", "M": ["أستعمل الخاصية في الاتجاهين", "لا أوزّع الجذر على الجمع أو الطرح", "أتأكد أن الأعداد موجبة"], "X": "يمكن أخذ جذر الجداء بجذر كل عامل ثم الضرب، وكذلك القسمة. لكن لا يمكن فعل ذلك مع الجمع، فجذر المجموع ليس مجموع الجذرين.", "EX": [["احسب `√0,9×√0,4` و `√60/√15`.", "`√0,9×√0,4=√(0,9×0,4)=√0,36=0,6`. `√60/√15=√(60/15)=√4=2`"], ["بيّن أن `√(16+9)≠√16+√9`.", "`√(16+9)=√25=5`. `√16+√9=4+3=7`. و `5≠7`. إذن المساواة غير صحيحة"]]}, {"n": 14, "m": 2, "i": "✂️", "t": "كتابة a√b وتبسيط العبارات", "B": [["الكتابة a√b", ["لكتابة `√n` على الشكل `a√b` نبحث عن أكبر مربع كامل `a²` يقسم n", "`n=a²×b` إذن `√n=a√b`", "b أصغر ما يمكن"]], ["أمثلة", ["`√8=√(4×2)=2√2`", "`√18=√(9×2)=3√2`", "`√50=√(25×2)=5√2`", "`√63=3√7`"]], ["جمع وطرح", ["نستعمل التوزيع: `x√b+y√b=(x+y)√b`", "الجذور المتشابهة فقط يمكن جمعها"]], ["جداء جذور", ["`√(50/3)×√2×√12`", "أحسب `√50×√2=√100=10` و `√12=2√3`", "فتجد `10×2√3/√3=20`"]]], "K": "اكتب كل جذر على الشكل `a√b` ثم اجمع الجذور المتشابهة بالتوزيع.", "M": ["أبحث عن أكبر مربع كامل يقسم العدد", "أجمع الجذور التي لها نفس b", "أتحقق بالحاسبة"], "X": "نخرج من تحت الجذر كل ما هو مربع كامل. بعدها تصبح الجذور متشابهة فنجمعها كما نجمع كلمات من نفس النوع.", "EX": [["بسّط `A=√8-3√18+2√50-7√2`.", "`√8=2√2` و `√18=3√2` و `√50=5√2`. `A=2√2-3(3√2)+2(5√2)-7√2`. `=(2-9+10-7)√2`. `=-4√2`"], ["احسب `A=√(50/3)×√2×√12`.", "`A=√(50/3×2×12)`. `50/3×2×12=400`. `A=√400=20`"]]}, {"n": 15, "m": 2, "i": "🎯", "t": "نسبة مقامها عدد غير ناطق", "B": [["الفكرة", ["نحوّل `a/√b` إلى نسبة مقامها عدد ناطق", "نضرب البسط والمقام في `√b`"]], ["القانون", ["`a/√b=(a×√b)/(√b×√b)=a√b/b`", "لأن `√b×√b=b`"]], ["أمثلة", ["`2/√11=2√11/11`", "`√7/(2√5)=√35/10`"]], ["لماذا؟", ["تسهيل المقارنة والحساب", "توحيد شكل النتائج"]]], "K": "اضرب البسط والمقام في الجذر الموجود في المقام.", "M": ["أنظر إلى المقام: هل فيه جذر؟", "أضرب البسط والمقام في العدد نفسه", "أبسّط النتيجة إن أمكن"], "X": "حين يكون في المقام جذر نكتب الكسر بطريقة أخرى تجعل المقام عددا عاديا، فنضرب فوق وتحت في الجذر نفسه فلا تتغير قيمته.", "EX": [["اكتب `2/√11` و `√7/(2√5)` بمقام ناطق.", "`2/√11=(2×√11)/(√11×√11)=2√11/11`. `√7/(2√5)=(√7×√5)/(2√5×√5)=√35/10`"], ["اكتب `4/√7` بمقام ناطق.", "`4/√7=(4×√7)/(√7×√7)=4√7/7`"]]}, {"n": 16, "m": 2, "i": "🧶", "t": "وضعية إدماجية: زربية وادي سوف", "B": [["المعطيات", ["المساحة 24 م²", "الطول ضعف العرض: `L=2ℓ`", "السعر 12000 دج معلومة لا تحتاجها"]], ["العلاقة", ["`24=L×ℓ=2ℓ×ℓ=2ℓ²`", "إذن `ℓ²=12`"]], ["الحل", ["`ℓ=√12=2√3`", "`ℓ≈3,46` م", "`L=2ℓ=4√3≈6,93` م"]], ["النتيجة بالسنتيمتر", ["العرض حوالي 346 سم", "الطول حوالي 693 سم"]]], "K": "أهمل المعطيات الزائدة، واكتب المساحة بدلالة العرض ثم حل `x²=a`.", "M": ["أختار المجهول ℓ", "أكتب المساحة بدلالته", "أحل `ℓ²=12` وأقبل الحل الموجب فقط"], "X": "المسألة بسيطة إذا عرفنا أن الطول ضعف العرض. نجد أن مربع العرض 12 فيكون العرض جذر 12 أي تقريبا 3,46 متر.", "EX": [["جد طول وعرض الزربية (بالتدوير إلى 1 سم).", "نضع ℓ العرض و `L=2ℓ`. `L×ℓ=24` أي `2ℓ²=24`. `ℓ²=12`. `ℓ=√12=2√3≈3,4641` م أي 346 سم. `L=2ℓ≈6,9282` م أي 693 سم"], ["تحقق من النتيجة.", "`346×693=239778` سم². وهذا يساوي تقريبا 23,98 م². وهو قريب من 24 م² بسبب التدوير"]]}, {"n": 17, "m": 3, "i": "✏️", "t": "النشر والتوزيع", "B": [["المفهوم", ["النشر هو كتابة جداء على شكل مجموع جبري", "التوزيع: `k(a+b)=ka+kb` و `k(a-b)=ka-kb`", "التوزيع المضاعف: `(a+b)(c+d)=ac+ad+bc+bd`"]], ["الطريقة", ["أضرب كل حد من العامل الأول في كل حد من العامل الثاني", "أنتبه إلى إشارة كل جداء", "أبسّط بجمع الحدود المتشابهة"]], ["مثال", ["`(x+1)(x+2)=x^{2}+2x+x+2=x^{2}+3x+2`", "`3(2x-5)=6x-15`"]], ["تنبيه", ["`-(a+b)=-a-b` أي تتغير إشارة كل حد داخل القوسين", "`-2(x-3)=-2x+6`"]]], "K": "`k(a+b)=ka+kb` و `(a+b)(c+d)=ac+ad+bc+bd`؛ أنشر ثم أبسّط الحدود المتشابهة.", "M": ["كل حد في الأول × كل حد في الثاني", "أراقب الإشارات السالبة", "أجمع `x^{2}` مع `x^{2}` و `x` مع `x` فقط"], "X": "النشر معناه فكّ الأقواس: نضرب كل حد من القوس الأول في كل حد من القوس الثاني ثم نجمع ما تشابه. مثل توزيع كل تلميذ في فوج على كل مقعد.", "EX": [["انشر وبسّط `(x+1)(x+2)`.", "`x×x=x^{2}`. `x×2=2x`. `1×x=x`. `1×2=2`. المجموع `x^{2}+2x+x+2=x^{2}+3x+2`"], ["انشر وبسّط `(2x-3)(x+4)`.", "`2x×x=2x^{2}`. `2x×4=8x`. `-3×x=-3x`. `-3×4=-12`. المجموع `2x^{2}+8x-3x-12=2x^{2}+5x-12`"]]}, {"n": 18, "m": 3, "i": "⭐", "t": "المتطابقات الشهيرة", "B": [["المتطابقة", ["المتطابقة مساواة صحيحة مهما كانت قيم الأحرف", "مثال: `3(x+2)=3x+6` صحيحة لكل x"]], ["مربع مجموع", ["`(a+b)^{2}=a^{2}+2ab+b^{2}`", "مثال: `(x+3)^{2}=x^{2}+6x+9`"]], ["مربع فرق", ["`(a-b)^{2}=a^{2}-2ab+b^{2}`", "مثال: `(x-4)^{2}=x^{2}-8x+16`"]], ["جداء مجموع في فرق", ["`(a+b)(a-b)=a^{2}-b^{2}`", "مثال: `(x+5)(x-5)=x^{2}-25`"]]], "K": "`(a+b)²=a²+2ab+b²` و `(a-b)²=a²-2ab+b²` و `(a+b)(a-b)=a²-b²`.", "M": ["أتعرف على الشكل: مربع أو جداء مجموع في فرق", "في المربع الحد الأوسط هو ضعف جداء الحدين", "في الفرق بين مربعين لا يوجد حد أوسط"], "X": "هذه ثلاث قوالب جاهزة توفر علينا النشر الطويل. نعرف النتيجة مباشرة بمجرد أن نتعرف على شكل العبارة.", "EX": [["انشر `(x+3)^{2}` و `(x-4)^{2}` و `(x+5)(x-5)`.", "`(x+3)^{2}=x^{2}+2×x×3+3^{2}=x^{2}+6x+9`. `(x-4)^{2}=x^{2}-8x+16`. `(x+5)(x-5)=x^{2}-5^{2}=x^{2}-25`"], ["بيّن أن `(a+b)^{2}=a^{2}+2ab+b^{2}`.", "`(a+b)^{2}=(a+b)(a+b)=a×a+a×b+b×a+b×b`. `=a^{2}+ab+ab+b^{2}`. `=a^{2}+2ab+b^{2}`"]]}, {"n": 19, "m": 3, "i": "🧩", "t": "النشر باستعمال المتطابقات", "B": [["الخطوات", ["أحدّد الحدّين a و b", "أطبّق المتطابقة المناسبة", "أبسّط النتيجة"]], ["مثال 1", ["`(2x+1)^{2}`: هنا `a=2x` و `b=1`", "`=(2x)^{2}+2×2x×1+1^{2}`", "`=4x^{2}+4x+1`"]], ["مثال 2", ["`(√3-4x)^{2}`: `a=√3` و `b=4x`", "`=3-2×√3×4x+16x^{2}`", "`=3-8√3x+16x^{2}`"]], ["مثال 3", ["`(2x-√5)(2x+√5)`", "`=(2x)^{2}-(√5)^{2}`", "`=4x^{2}-5`"]]], "K": "حدّد a و b ثم عوّض في المتطابقة؛ لا تنس تربيع المعامل: `(2x)²=4x²`.", "M": ["أضع كل حد بين قوسين قبل التربيع", "أتذكر أن `(√5)^{2}=5`", "أراجع الإشارة قبل الحد الأوسط"], "X": "عندما يكون في الحدين أعداد وجذور نربع كل شيء داخل القوس: معامل x يُربَّع وx أيضا. ثم نطبق القالب كما هو.", "EX": [["انشر `(2x+1)^{2}`.", "`a=2x` و `b=1`. `(2x)^{2}=4x^{2}`. الضعف `2×2x×1=4x`. `1^{2}=1`. إذن `(2x+1)^{2}=4x^{2}+4x+1`"], ["انشر `(√3-4x)^{2}` و `(2x-√5)(2x+√5)`.", "`(√3-4x)^{2}=(√3)^{2}-2×√3×4x+(4x)^{2}=3-8√3x+16x^{2}`. `(2x-√5)(2x+√5)=(2x)^{2}-(√5)^{2}=4x^{2}-5`"]]}, {"n": 20, "m": 3, "i": "🔗", "t": "التحليل بإخراج عامل مشترك", "B": [["التعريف", ["التحليل هو كتابة مجموع جبري على شكل جداء", "`ka+kb=k(a+b)` و `ka-kb=k(a-b)`"]], ["الطريقة", ["أبحث عن العامل المشترك في كل الحدود", "أخرجه أمام قوس", "أكتب في القوس ما بقي من كل حد"]], ["مثال", ["`A=4x(x+1)-12x^{2}`", "العامل المشترك `4x`: `A=4x(x+1)-4x×3x`", "`A=4x[(x+1)-3x]=4x(1-2x)`"]], ["عامل مشترك مجموع", ["`B=(x-5)(x+1)+2(x-5)`", "العامل المشترك `(x-5)`", "`B=(x-5)[(x+1)+2]=(x-5)(x+3)`"]]], "K": "`ka+kb=k(a+b)`؛ ابحث عن العامل المشترك وقد يكون عددا أو عبارة بين قوسين.", "M": ["أتحقق بالنشر بعد التحليل", "العامل المشترك قد يكون قوسا كاملا", "أبسّط ما داخل القوس الثاني"], "X": "التحليل عكس النشر. نبحث عن شيء مشترك بين الحدود فنخرجه كما نخرج عنصرا مشتركا من عدة مجموعات.", "EX": [["حلّل `A=4x(x+1)-12x^{2}`.", "`12x^{2}=4x×3x`. العامل المشترك `4x`. `A=4x(x+1)-4x×3x=4x[(x+1)-3x]=4x(1-2x)`. تحقق: `4x-8x^{2}` و `4x^{2}+4x-12x^{2}=4x-8x^{2}` ✓"], ["حلّل `A=(x-3)^{2}+2(x-3)`.", "العامل المشترك `(x-3)`. `A=(x-3)[(x-3)+2]=(x-3)(x-1)`. وبالنشر `A=x^{2}-6x+9+2x-6=x^{2}-4x+3`"]]}, {"n": 21, "m": 3, "i": "🔓", "t": "التحليل باستعمال المتطابقات", "B": [["التحليل بمتطابقة", ["`a^{2}+2ab+b^{2}=(a+b)^{2}`", "`a^{2}-2ab+b^{2}=(a-b)^{2}`", "`a^{2}-b^{2}=(a+b)(a-b)`"]], ["مثال 1", ["`A=25+10x+x^{2}`", "`25=5^{2}` و `x^{2}` و `10x=2×5×x`", "`A=(5+x)^{2}`"]], ["مثال 2", ["`B=49x^{2}-14x+1`", "`49x^{2}=(7x)^{2}` و `1=1^{2}` و `14x=2×7x×1`", "`B=(7x-1)^{2}`"]], ["مثال 3 (فرق مربعين)", ["`C=(4x-1)^{2}-(x-4)^{2}`", "`C=[(4x-1)-(x-4)][(4x-1)+(x-4)]`", "`C=(3x+3)(5x-5)=15(x+1)(x-1)`"]]], "K": "اقرأ المتطابقة بالعكس: مربع كامل أو فرق بين مربعين فيتحول إلى جداء.", "M": ["أتحقق أن الحد الأوسط ضعف جداء الجذرين", "أكتب كل مربع على شكل `(...)^{2}`", "بعد فرق المربعين أبسّط كل قوس وأخرج العامل المشترك"], "X": "نتفحص العبارة: هل هي ثلاثة حدود فيها مربعان وضعف جداء؟ هل هي فرق بين مربعين؟ إن كان كذلك فالتحليل جاهز.", "EX": [["حلّل `A=25+10x+x^{2}` و `B=49x^{2}-14x+1`.", "`A=5^{2}+2×5×x+x^{2}=(5+x)^{2}`. `B=(7x)^{2}-2×7x×1+1^{2}=(7x-1)^{2}`"], ["حلّل `C=(4x-1)^{2}-(x-4)^{2}`.", "فرق مربعين: `C=[(4x-1)-(x-4)][(4x-1)+(x-4)]`. `(4x-1)-(x-4)=3x+3=3(x+1)`. `(4x-1)+(x-4)=5x-5=5(x-1)`. `C=15(x+1)(x-1)`"]]}, {"n": 22, "m": 3, "i": "🏊", "t": "وضعية إدماجية: المسبح الأزرق", "B": [["المعطيات", ["مسبح مربع طول ضلعه 10 م", "محاط بإطار عرضه x", "مساحة الإطار 44 م²"]], ["كتابة المعادلة", ["ضلع المربع الكبير `10+2x`", "مساحة الإطار `(10+2x)^{2}-100`", "المعادلة: `(10+2x)^{2}-100=44`"]], ["التبسيط", ["`4x^{2}+40x+100-100=44`", "`4x^{2}+40x-44=0`", "`x^{2}+10x-11=0`"]], ["التحليل والحل", ["`x^{2}+10x-11=(x-1)(x+11)`", "`x=1` أو `x=-11`", "العرض موجب إذن `x=1` م"]]], "K": "اكتب مساحة الإطار بالفرق بين مساحتين، وانشر، ثم حلّل واستعمل الجداء المعدوم.", "M": ["أرسم الشكل وأكتب الأضلاع", "المساحة الكلية ناقص مساحة المسبح", "أرفض الحلول السالبة لأن العرض موجب"], "X": "الإطار هو ما يتبقى من المربع الكبير بعد حذف المربع الصغير. نجعل المساحة مساوية للمعلومة 44 ونحلّل لنحصل على حلين، ونختار الموجب.", "EX": [["احسب عرض الإطار x.", "`(10+2x)^{2}-100=44`. `100+40x+4x^{2}-100=44`. `4x^{2}+40x-44=0` أي `x^{2}+10x-11=0`. `(x-1)(x+11)=0`. `x=1` أو `x=-11`. العرض موجب إذن `x=1` م"], ["تحقق من النتيجة.", "إذا `x=1`: الضلع الكبير `10+2=12`. مساحته 144. نطرح 100 فنجد 44 ✓"]]}, {"n": 23, "m": 4, "i": "⚖️", "t": "معادلة من الدرجة الأولى بمجهول واحد", "B": [["التعريف", ["كل معادلة من الدرجة الأولى بمجهول واحد تؤول إلى `ax=b` مع `a≠0`", "حلها الوحيد `x=b/a`"]], ["القواعد", ["أضيف أو أطرح العدد نفسه من الطرفين", "أضرب أو أقسم الطرفين على عدد غير معدوم"]], ["مثال 1", ["`2x-5=8`", "`2x=13`", "`x=13/2`"]], ["مثال 2 (أعداد عشرية)", ["`2,5x+4,6=1,3x-0,2`", "`1,2x=-4,8`", "`x=-4`"]]], "K": "أجمع الحدود التي فيها x في طرف والأعداد في الطرف الآخر، ثم أقسم على المعامل.", "M": ["أتحقق بتعويض الحل", "أنقل الحد مع تغيير الإشارة", "أقسم على معامل x في الآخر"], "X": "المعادلة ميزان متوازن: ما نفعله بأحد الكفتين نفعله بالأخرى. نصل إلى كفة فيها x وحده.", "EX": [["حل `2x-5=8`.", "`2x=8+5=13`. `x=13/2=6,5`. تحقق: `2×6,5-5=8` ✓"], ["حل `2,5x+4,6=1,3x-0,2`.", "`2,5x-1,3x=-0,2-4,6`. `1,2x=-4,8`. `x=-4`. تحقق: `2,5×(-4)+4,6=-5,4` و `1,3×(-4)-0,2=-5,4` ✓"]]}, {"n": 24, "m": 4, "i": "✖️", "t": "معادلة جداء معدوم", "B": [["الخاصية", ["إذا كان جداء عاملين معدوما فأحدهما على الأقل معدوم", "`A×B=0` معناه `A=0` أو `B=0`"]], ["معادلة `(ax+b)(cx+d)=0`", ["حلاها: حل `ax+b=0` وحل `cx+d=0`"]], ["مثال", ["`(3x-4)(-2x+1)=0`", "`3x-4=0` أي `x=4/3`", "`-2x+1=0` أي `x=1/2`"]], ["الطريقة العامة", ["أنقل كل الحدود إلى طرف واحد", "أحلل العبارة إلى جداء", "أحل كل معادلة من الدرجة الأولى"]]], "K": "`A×B=0` يعني `A=0` أو `B=0`؛ حلّل أولا ثم حل المعادلتين.", "M": ["أتأكد أن الطرف الثاني صفر", "أحلل بإخراج عامل مشترك", "أكتب الحلين معا"], "X": "الجداء لا يكون صفرا إلا إذا كان أحد عوامله صفرا. لذلك نحوّل المعادلة المعقدة إلى جداء ثم نبحث متى يصبح كل عامل صفرا.", "EX": [["حل `(3x-4)(-2x+1)=0`.", "`3x-4=0` فـ `x=4/3`. أو `-2x+1=0` فـ `x=1/2`. الحلان `4/3` و `1/2`"], ["حل `(1-2x)(4x-3)-3(4x-3)=0`.", "العامل المشترك `(4x-3)`. `(4x-3)[(1-2x)-3]=0`. `(4x-3)(-2x-2)=0`. `4x-3=0` فـ `x=3/4`. أو `-2x-2=0` فـ `x=-1`"]]}, {"n": 25, "m": 4, "i": "📏", "t": "المتراجحات من الدرجة الأولى", "B": [["الشكل العام", ["`ax+b<cx+d` أو `≤` أو `>` أو `≥`"]], ["القواعد", ["جمع أو طرح العدد نفسه من الطرفين لا يغير اتجاه المتراجحة", "الضرب أو القسمة على عدد موجب لا يغير الاتجاه", "الضرب أو القسمة على عدد سالب يعكس الاتجاه"]], ["مثال 1", ["`4x-1≤x+3`", "`3x≤4`", "`x≤4/3`"]], ["مثال 2", ["`-3x+2>20`", "`-3x>18`", "`x<-6` (انعكس الاتجاه)"]]], "K": "حل المتراجحة كحل المعادلة، لكن عند الضرب أو القسمة على عدد سالب يُعكس اتجاه المتراجحة.", "M": ["أنتبه للقسمة على عدد سالب", "أنقل الحدود كما في المعادلات", "أكتب الحل على شكل مجال"], "X": "المتراجحة ميزان غير متوازن. إذا ضربنا الطرفين في عدد سالب انقلب الترتيب: 2<3 لكن -2>-3.", "EX": [["حل `-7x+1<x-3`.", "`-7x-x<-3-1`. `-8x<-4`. نقسم على -8 فينعكس الاتجاه: `x>1/2`"], ["حل `(3x+2)/6≥(2x-3)/5`.", "نضرب في 30: `5(3x+2)≥6(2x-3)`. `15x+10≥12x-18`. `3x≥-28`. `x≥-28/3`"]]}, {"n": 26, "m": 4, "i": "📈", "t": "التمثيل البياني لحلول متراجحة", "B": [["على مستقيم مدرّج", ["نظلل جزء المستقيم الذي يمثل الحلول", "القوس يوجّه إلى الجهة غير المحتواة"]], ["الحد المشمول", ["`x≤a`: العدد a مشمول (قوس مغلق عند a)", "`x<a`: العدد a غير مشمول (قوس مفتوح عند a)"]], ["شرطان معا", ["نأخذ التقاطع بين مجموعتي الحلول", "`-4≤x<-1` معناه x بين -4 و -1 مع شمول -4 فقط"]], ["مثال (من الكتاب)", ["`-3x+1>7x+11` و `1/2 x-3≤x-1` معا", "الأولى: `x<-1`", "الثانية: `x≥-4`"]]], "K": "مثّل كل شرط على المستقيم ثم خذ الجزء المشترك بين التظليلين.", "M": ["أحل كل متراجحة على حدة", "أحدد هل الحد مشمول أم لا", "أكتب مجموعة الحلول المشتركة"], "X": "نرسم مستقيما ونظلل مكان الأعداد التي تصلح. عندما يكون هناك شرطان نأخذ ما يشترك فيه التظليلان.", "EX": [["عيّن قيم x التي تحقق المتراجحتين معا: `-3x+1>7x+11` و `1/2 x-3≤x-1`.", "الأولى: `-10x>10` فـ `x<-1`. الثانية: `-1/2 x≤2` فـ `x≥-4`. القيم المشتركة: `-4≤x<-1`"], ["ما هي قيم x التي يمكن من أجلها إنشاء مثلث أطوال أضلاعه x و 5 و 7 سنتيمتر؟", "في المثلث كل ضلع أصغر من مجموع الضلعين الآخرين وأكبر من فرقهما. `7-5<x<7+5`. إذن `2<x<12`"]]}, {"n": 27, "m": 4, "i": "🧠", "t": "مسائل تُحل بمعادلة أو متراجحة", "B": [["خطوات الحل", ["أختار المجهول", "أترجم المسألة إلى معادلة أو متراجحة", "أحلها", "أتحقق وأجيب"]], ["مثال: الأعمار", ["الأب 36 سنة وأبناؤه 4 و 6 و 8", "بعد t سنة: `36+t=(4+t)+(6+t)+(8+t)`", "`36+t=18+3t` فـ `t=9`"]], ["مثال: برنامج حساب", ["اختر عددا x، اضربه في 3، أضف 5", "`3x+5=32` فـ `x=9`", "`3x+5=2x` فـ `x=-5`"]], ["مثال: مقارنة عرضين", ["العرض 1: `75x`", "العرض 2: `560+5x`", "`75x>560+5x` فـ `x>8`"]]], "K": "ترجمة المسألة إلى معادلة هي نصف الحل؛ اختر المجهول بعناية وتحقق من النتيجة.", "M": ["أعرّف المجهول بجملة واضحة", "أترجم كل معلومة إلى علاقة", "أتحقق أن النتيجة تلائم المسألة"], "X": "نحوّل الكلام إلى رموز. مثلا «ضعف العدد» تعني 2x، و«نصل إلى 32» تعني أن الطرف الآخر يساوي 32.", "EX": [["بعد كم سنة يصبح عمر الأب مساويا لمجموع أعمار أبنائه (36 سنة والأبناء 4 و 6 و 8)؟", "نضع t. عمر الأب `36+t`. مجموع الأبناء `18+3t`. `36+t=18+3t`. `2t=18`. `t=9`. بعد 9 سنوات: الأب 45 والأبناء 13 و 15 و 17 ومجموعها 45 ✓"], ["برنامج الحساب: اختر عددا، اضربه في 3، ثم أضف 5. ما العدد الذي يعطي 32؟ وما العدد الذي يعطي ضعفه؟", "`3x+5=32` فـ `3x=27` و `x=9`. `3x+5=2x` فـ `x=-5`. تحقق: `3×(-5)+5=-10=2×(-5)` ✓"]]}, {"n": 28, "m": 4, "i": "🧮", "t": "معادلات ومتراجحات بالتحليل (تمارين مختارة)", "B": [["E=(5x−1)²−(2x+3)(5x−1)", ["النشر: `E=15x^{2}-23x+4`", "التحليل: `E=(5x-1)(3x-4)`", "`E=0` حلاها `1/5` و `4/3`"]], ["من شهادة التعليم المتوسط", ["`E=(4x-1)^{2}-(3x+2)(4x-1)`", "النشر: `E=4x^{2}-13x+3`", "التحليل: `E=(4x-1)(x-3)`"]], ["حل المتراجحة", ["`4x^{2}-13x+3≤4x^{2}+29`", "الحدّان `4x^{2}` يختصران: `-13x≤26`", "`x≥-2`"]], ["نصيحة", ["حين تحتوي المتراجحة `x^{2}` في الطرفين اختصرهما أولا", "قد تصبح من الدرجة الأولى"]]], "K": "حلّل بإخراج العامل المشترك ثم استعمل الجداء المعدوم؛ واختصر `x²` في المتراجحات.", "M": ["أُخرج العامل المشترك `(5x-1)` أو `(4x-1)`", "أتحقق من التحليل بالنشر", "أعكس الاتجاه عند القسمة على سالب"], "X": "هذه التمارين تجمع كل أدوات الباب: النشر لفكّ الأقواس، والتحليل لإيجاد الجداء، والجداء المعدوم لحل المعادلة، وأخيرا المتراجحة.", "EX": [["`E=(5x-1)^{2}-(2x+3)(5x-1)`: انشر وبسّط، حلّل، ثم حل `E=0`.", "`(5x-1)^{2}=25x^{2}-10x+1`. `(2x+3)(5x-1)=10x^{2}+13x-3`. `E=15x^{2}-23x+4`. تحليل: `E=(5x-1)[(5x-1)-(2x+3)]=(5x-1)(3x-4)`. `E=0`: `x=1/5` أو `x=4/3`. قيمة E عند `x=-1` هي `(−6)(−7)=42`"], ["شهادة التعليم المتوسط: `E=(4x-1)^{2}-(3x+2)(4x-1)`: انشر، حلّل، حل `E=0` ثم حل `4x^{2}-13x+3≤4x^{2}+29`.", "`E=16x^{2}-8x+1-(12x^{2}+5x-2)=4x^{2}-13x+3`. `E=(4x-1)(x-3)`. `E=0`: `x=1/4` أو `x=3`. المتراجحة: `-13x≤26` فـ `x≥-2`"], ["`A=(3x+4)(x-7)-(54x^{2}-96)`: حلّل A وحل `A=0` وحل `54x^{2}-96≤18x(3x+1)-90`.", "`54x^{2}-96=6(3x+4)(3x-4)`. `A=(3x+4)[(x-7)-6(3x-4)]=(3x+4)(17-17x)=17(3x+4)(1-x)`. `A=0`: `x=-4/3` أو `x=1`. المتراجحة: `54x^{2}-96≤54x^{2}+18x-90` فـ `18x≥-6` فـ `x≥-1/3`"]]}, {"n": 29, "m": 4, "i": "🏊", "t": "وضعية إدماجية: نادي السباحة", "B": [["المعطيات", ["العرض 1: 75 دج للحصة", "العرض 2: اشتراك سنوي 560 دج + 5 دج للحصة"]], ["المجهول", ["x عدد الحصص في السنة"]], ["الكلفتان", ["العرض 1: `75x`", "العرض 2: `560+5x`"]], ["المقارنة", ["العرض 2 أفضل إذا `560+5x<75x`", "`560<70x` أي `x>8`", "عند 8 حصص الكلفتان متساويتان: 600 دج"]]], "K": "قارن الكلفتين بمتراجحة: العرض الأرخص يتغير بعد 8 حصص.", "M": ["أكتب كلفة كل عرض بدلالة x", "أضع المتراجحة وأحلها", "أترجم النتيجة إلى جملة"], "X": "بالاشتراك السنوي ندفع مبلغا ثابتا مع سعر صغير للحصة، فيصبح أرخص لمن يزور كثيرا. نحسب متى تتساوى الكلفتان.", "EX": [["متى يكون العرض 2 أفضل من العرض 1؟", "`75x` كلفة 1 و `560+5x` كلفة 2. `560+5x<75x`. `560<70x`. `x>8`. أي من الحصة التاسعة فما فوق العرض 2 أرخص"], ["احسب الكلفتين عند 8 حصص وعند 10 حصص.", "عند 8: `75×8=600` و `560+40=600` متساويتان. عند 10: `750` و `560+50=610` فالعرض 2 أرخص"]]}];
