<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Zad dz</title>
<style>
:root{--bg1:#1e3a8a;--bg2:#7c3aed;--card:#ffffff;--ink:#1a2332;--acc:#fbbf24;--ok:#10b981;--danger:#ef4444}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;font-family:'Segoe UI',Tahoma,Arial,sans-serif;min-height:100vh;color:#fff;
 background:linear-gradient(160deg,var(--bg1),var(--bg2));padding:env(safe-area-inset-top) 16px 24px}
header{text-align:center;padding:20px 0 6px;position:relative}
#appLogo{width:104px;height:104px;display:block;margin:0 auto 6px;filter:drop-shadow(0 4px 10px rgba(0,0,0,.35))}
header img{width:64px;height:64px;border-radius:16px;box-shadow:0 6px 18px rgba(0,0,0,.35)}
h1{margin:10px 0 2px;font-size:25px;letter-spacing:1px}
.sub{opacity:.85;font-size:13px;margin:0 0 6px}
.trialbar{max-width:520px;margin:0 auto 14px;background:rgba(255,255,255,.14);border-radius:14px;padding:8px 14px;font-size:13px;text-align:center}
.trialbar.warn{background:rgba(239,68,68,.35)}
.actbtn{position:absolute;left:0;top:18px;background:var(--acc);color:var(--ink);border:0;border-radius:12px;padding:6px 10px;font-size:18px;cursor:pointer}
.backbtn{position:absolute;right:0;top:18px;background:rgba(255,255,255,.18);color:#fff;border:0;border-radius:12px;padding:6px 12px;font-size:14px;cursor:pointer}

/* ===== شاشة اختيار المرحلة (الرئيسية الأولى) ===== */
.stageGrid{display:flex;flex-direction:column;gap:16px;max-width:480px;margin:40px auto;min-height:50vh;justify-content:center}
.stageBtn{border:0;border-radius:22px;padding:26px 18px;text-align:center;cursor:pointer;color:#fff;
 box-shadow:0 10px 24px rgba(0,0,0,.35);transition:transform .15s}
.stageBtn:active{transform:scale(.97)}
.stageBtn.am{background:linear-gradient(135deg,#1d4ed8,#0ea5e9)}
.stageBtn.as{background:linear-gradient(135deg,#7e22ce,#db2777)}
.stageBtn .big{font-size:22px;font-weight:bold;display:block}
.stageBtn .small{font-size:13px;opacity:.9;display:block;margin-top:6px}

/* ===== شبكة سنوات المتوسط (صغيرة ومضبوطة) ===== */
.grid{display:flex;flex-direction:column;gap:12px;max-width:480px;margin:auto}
.lv{position:relative;border:0;border-radius:18px;padding:14px 16px;overflow:hidden;cursor:pointer;
 width:100%;display:flex;align-items:center;gap:14px;box-shadow:0 6px 16px rgba(0,0,0,.3);transition:transform .15s;color:#fff}
.lv:active{transform:scale(.97)}
.lv .badge{width:50px;height:50px;border-radius:12px;background:rgba(255,255,255,.22);display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:15px;flex:none}
.lv .lvName{font-size:18px;font-weight:bold;flex:1;text-align:right}
.lv.c1{background:linear-gradient(135deg,#1d4ed8,#0ea5e9)}
.lv.c2{background:linear-gradient(135deg,#047857,#10b981)}
.lv.c3{background:linear-gradient(135deg,#c2410c,#f59e0b)}
.lv.c4{background:linear-gradient(135deg,#7e22ce,#ec4899)}

/* ===== شبكة سنوات الثانوي (قريبًا) ===== */
.asNote{max-width:480px;margin:0 auto 14px;background:rgba(255,255,255,.14);border-radius:14px;padding:10px 14px;font-size:13px;text-align:center}
.asShu{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:8px}
.asShu span{background:rgba(255,255,255,.15);border-radius:10px;padding:4px 10px;font-size:12px}
.soon{position:absolute;left:14px;top:50%;transform:translateY(-50%);background:rgba(0,0,0,.3);border-radius:10px;padding:3px 9px;font-size:11px}

#view,#subjectView,#chat,#actScreen,#webview,#lessonsScr,#hub{display:none;max-width:720px;margin:auto}
#webview.show{display:flex;position:fixed;inset:0;max-width:100%;z-index:40;flex-direction:column;background:#fff}
#webview .wvTop{display:flex;align-items:center;gap:10px;padding:env(safe-area-inset-top) 10px 8px;background:var(--bg1);color:#fff}
#webview .wvTop button{background:rgba(255,255,255,.2);color:#fff;border:0;border-radius:10px;padding:8px 12px;font-size:14px}
#webview .wvTop span{flex:1;font-size:13px;opacity:.9;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#webview iframe{flex:1;border:0;width:100%}
.top{display:flex;align-items:center;gap:10px;margin:14px 0}
.top button{background:rgba(255,255,255,.18);color:#fff;border:0;border-radius:12px;padding:10px 14px;font-size:15px;cursor:pointer}
.top h2{margin:0;font-size:19px;flex:1}
.chips{display:flex;gap:8px;overflow-x:auto;padding:4px 0 10px}
.chips button{flex:none;border:0;border-radius:20px;padding:8px 14px;font-size:14px;background:rgba(255,255,255,.18);color:#fff;font-family:inherit;cursor:pointer}
.chips button.on{background:var(--acc);color:var(--ink);font-weight:bold}
#q,#lsearch{width:100%;padding:12px 14px;border-radius:14px;border:0;font-size:16px;margin-bottom:6px;font-family:inherit}
.sec{margin-top:20px}
.sec h3{margin:0 0 8px;font-size:17px;border-right:5px solid var(--acc);padding-right:10px}
.card{background:var(--card);border-radius:16px;padding:6px 14px;box-shadow:0 2px 8px rgba(0,0,0,.2)}
.card a{display:flex;gap:10px;align-items:center;color:#1a56a0;text-decoration:none;font-weight:bold;font-size:16px;padding:11px 0;border-bottom:1px solid #eef1f6}
.card a:last-child{border-bottom:0}

/* subjects grid inside a level */
.subjgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}
.subj{background:var(--card);color:var(--ink);border-radius:18px;padding:16px 10px;text-align:center;box-shadow:0 4px 12px rgba(0,0,0,.25);cursor:pointer;border:0;font-family:inherit}
.subj .ic{font-size:30px;display:block;margin-bottom:6px}
.subj .name{font-weight:bold;font-size:14px}
.subj .btnrow{display:flex;flex-direction:column;gap:5px;margin-top:8px}
.subj .btnrow button{background:var(--bg2);color:#fff;border:0;border-radius:10px;padding:6px 8px;font-size:12px;width:100%;font-family:inherit}
.subj .btnrow button.quizbtn{background:#059669}
.subj .btnrow button.explainbtn{background:#7c3aed}

/* شاشة الدروس/التمارين المحلية */
#lessonsScr.show,#hub.show{display:block;position:fixed;inset:0;z-index:45;background:linear-gradient(160deg,var(--bg1),var(--bg2));
 padding:env(safe-area-inset-top) 16px 20px;overflow-y:auto}
.lsTabs{display:flex;gap:8px;margin:10px 0}
.lsTabs button{flex:1;border:0;border-radius:12px;padding:10px;background:rgba(255,255,255,.15);color:#fff;font-family:inherit;font-size:14px}
.lsTabs button.on{background:var(--acc);color:var(--ink);font-weight:bold}
.lsItem{background:var(--card);color:var(--ink);border-radius:14px;padding:13px 16px;margin-bottom:8px;cursor:pointer;font-weight:bold}
.lsContent{background:var(--card);color:var(--ink);border-radius:16px;padding:18px;line-height:2;white-space:pre-wrap;font-size:15px}
.lsContent h4{margin:0 0 10px;font-size:18px}

#hub.show{z-index:40}
#quiz{display:none}
.hubGrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:6px 0 4px}
.hubBtn{background:var(--card);color:var(--ink);border:0;border-radius:16px;padding:16px 8px;font-family:inherit;font-weight:bold;font-size:15px;text-align:center;box-shadow:0 3px 10px rgba(0,0,0,.22)}
.hubBtn small{display:block;font-weight:normal;color:#6b7280;font-size:12px;margin-top:3px}
.hubBtn.off{opacity:.5}
.hubBtn .ic{font-size:26px;display:block;margin-bottom:4px}
.subj{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:96px}
.qProg{text-align:center;color:#fff;margin-bottom:8px;font-size:14px}
.qOpt{display:block;width:100%;text-align:right;background:#f3f4f6;border:0;border-radius:10px;padding:11px;margin-bottom:6px;font-family:inherit;font-size:15px;color:var(--ink)}
.qOpt.correct{background:#bbf7d0}.qOpt.wrong{background:#fecaca}
.qAns{background:#ecfdf5;border-radius:10px;padding:10px;margin:8px 0;white-space:pre-wrap;line-height:1.9}
#quiz.show{display:block;position:fixed;inset:0;z-index:45;background:linear-gradient(160deg,var(--bg1),var(--bg2));
 padding:env(safe-area-inset-top) 16px 20px;overflow-y:auto}
.qTop{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.qTop button{background:rgba(255,255,255,.18);color:#fff;border:0;border-radius:12px;padding:8px 12px}
.qCard{background:var(--card);color:var(--ink);border-radius:16px;padding:16px;margin-bottom:14px}
.qCard .qtext{font-weight:bold;margin-bottom:10px}
.qCard label{display:block;background:#f3f4f6;border-radius:10px;padding:10px;margin-bottom:6px;cursor:pointer}
.qCard label.correct{background:#bbf7d0}
.qCard label.wrong{background:#fecaca}
.qSubmit{width:100%;background:var(--acc);color:var(--ink);border:0;border-radius:14px;padding:13px;font-weight:bold;font-size:16px;margin-top:6px}
.qScore{text-align:center;font-size:18px;font-weight:bold;margin:10px 0}
.topicBox{max-width:420px;margin:50px auto 0;background:rgba(255,255,255,.14);border-radius:18px;padding:22px;text-align:center}
.topicBox input{width:100%;padding:12px;border-radius:12px;border:0;font-size:16px;margin:12px 0;font-family:inherit}
.topicBox button{width:100%;background:var(--acc);color:var(--ink);border:0;border-radius:14px;padding:13px;font-weight:bold}
.loadingDots{text-align:center;padding:30px;font-size:15px;opacity:.85}

/* chat */
#chat{display:none;flex-direction:column;height:calc(100vh - 20px)}
#chat.show{display:flex;position:fixed;inset:0;z-index:46;height:auto;max-width:none;background:linear-gradient(160deg,var(--bg1),var(--bg2));padding:env(safe-area-inset-top) 16px 10px}
.chatTop{display:flex;align-items:center;gap:10px;padding:10px 4px}
.chatTop button{background:rgba(255,255,255,.18);color:#fff;border:0;border-radius:12px;padding:8px 12px}
.chatTop h2{margin:0;font-size:16px;flex:1}
#topicBar{display:flex;gap:6px;overflow-x:auto;padding:6px 2px;flex:none}
#topicBar button{flex:none;border:0;border-radius:16px;padding:7px 12px;background:rgba(255,255,255,.2);color:#fff;font-family:inherit;font-size:13px;white-space:nowrap}
#topicBar button.ex{background:rgba(251,191,36,.35)}
#msgs{flex:1;overflow-y:auto;padding:10px 4px;display:flex;flex-direction:column;gap:10px}
.msg{max-width:85%;padding:10px 14px;border-radius:16px;font-size:15px;line-height:1.7;white-space:pre-wrap}
.msg.user{align-self:flex-start;background:var(--acc);color:var(--ink);border-bottom-left-radius:4px}
.msg.bot{align-self:flex-end;background:var(--card);color:var(--ink);border-bottom-right-radius:4px}
.chatIn{display:flex;gap:8px;padding:8px 0 4px}
.chatIn input{flex:1;border:0;border-radius:14px;padding:12px 14px;font-size:15px;font-family:inherit}
.chatIn button{background:var(--acc);color:var(--ink);border:0;border-radius:14px;padding:0 18px;font-weight:bold}
.typing{align-self:flex-end;font-size:13px;opacity:.8;background:var(--card);color:var(--ink);padding:6px 12px;border-radius:12px}

/* activation overlay */
#actScreen.show{display:block;position:fixed;inset:0;background:linear-gradient(160deg,var(--bg1),var(--bg2));z-index:50;
 padding:env(safe-area-inset-top) 20px 24px;overflow-y:auto}
.actbox{max-width:420px;margin:60px auto 0;background:rgba(255,255,255,.12);border-radius:20px;padding:24px;text-align:center}
.actbox h2{margin:0 0 6px}
.actbox p{opacity:.9;line-height:1.8;font-size:14px}
.deviceCode{background:rgba(0,0,0,.25);border-radius:12px;padding:12px;font-size:20px;letter-spacing:3px;margin:14px 0;direction:ltr}
.actbox input{width:100%;padding:12px;border-radius:12px;border:0;font-size:16px;margin:10px 0;text-align:center;direction:ltr;font-family:inherit}
.actbox button{width:100%;background:var(--acc);color:var(--ink);border:0;border-radius:14px;padding:13px;font-weight:bold;font-size:16px;margin-top:6px}
.actMsg{font-size:13px;margin-top:10px;min-height:18px}
.actbox{position:relative}
.actbox .actClose{position:absolute;top:10px;left:10px;width:34px;height:34px;padding:0;margin:0;border-radius:50%;background:rgba(255,255,255,.2);color:#fff;font-size:16px}
.licList{margin-top:16px;text-align:right;font-size:13px;line-height:1.9}
.licList div{display:flex;justify-content:space-between;gap:8px;background:rgba(0,0,0,.18);border-radius:10px;padding:6px 10px;margin-top:6px}
.licList .on{color:#bbf7d0}.licList .off{opacity:.75}
.sideBtn{position:absolute;width:42px;height:42px;padding:0;border:0;border-radius:50%;font-size:20px;line-height:42px;cursor:pointer;color:#fff;box-shadow:0 4px 12px rgba(0,0,0,.3)}
.supbtn{left:0;top:66px;background:#22c55e}
.sharebtn{right:0;top:18px;background:#a855f7}
.backbtn[style*="block"] ~ .sharebtn{top:62px}
.sideBtn:active{transform:scale(.93)}
@keyframes zblink{0%,100%{opacity:1}50%{opacity:.12}}
.blink{animation:zblink 1s ease-in-out infinite}
.actTap{font-size:18px;font-weight:bold;margin:8px 0 10px;color:#fde68a}
.actbox .actReq{background:#22c55e;color:#fff;margin:0 0 10px}
#shareSheet{display:none;position:fixed;inset:0;z-index:60;background:rgba(0,0,0,.55);align-items:flex-end;justify-content:center}
#shareSheet.show{display:flex}
.shBox{width:100%;max-width:520px;background:linear-gradient(160deg,var(--bg1),var(--bg2));border-radius:22px 22px 0 0;padding:18px 16px calc(18px + env(safe-area-inset-bottom));box-shadow:0 -8px 30px rgba(0,0,0,.4)}
.shBox h3{margin:0 0 4px;text-align:center}
.shBox p{margin:0 0 14px;text-align:center;font-size:13px;opacity:.85}
.shGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.shGrid button{background:rgba(255,255,255,.14);color:#fff;border:0;border-radius:14px;padding:12px 4px;font-size:13px;font-family:inherit;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:4px}
.shGrid button span{font-size:26px;line-height:1}
.shGrid button:active{transform:scale(.95)}
.shNote{min-height:18px;margin-top:10px;font-size:13px;text-align:center;color:#bbf7d0}
.shClose{display:block;width:100%;margin-top:10px;background:rgba(255,255,255,.2);color:#fff;border:0;border-radius:14px;padding:11px;font-size:15px;font-family:inherit;cursor:pointer}
.lockPanel{background:rgba(255,255,255,.14);border-radius:16px;padding:22px;text-align:center;line-height:1.9;margin-top:14px}
.lockPanel button{background:var(--acc);color:var(--ink);border:0;border-radius:14px;padding:11px 20px;font-weight:bold;font-size:15px;margin-top:8px}
.actMsg.err{color:#fecaca}
.actMsg.ok{color:#bbf7d0}

.empty{background:rgba(255,255,255,.14);border-radius:16px;padding:22px;text-align:center;line-height:1.9}
.note{font-size:12px;opacity:.8;text-align:center;margin-top:22px;line-height:1.7}
</style>
</head>
<body>

<!-- ===================== نافذة المشاركة ===================== -->
<div id="shareSheet" onclick="if(event.target===this)closeShare()">
  <div class="shBox">
    <h3>🔗 شارك التطبيق</h3>
    <p>اختر التطبيق أو الموقع الذي تريد المشاركة عبره</p>
    <div class="shGrid" id="shGrid"></div>
    <div class="shNote" id="shNote"></div>
    <button class="shClose" onclick="closeShare()">إغلاق</button>
  </div>
</div>

<!-- ===================== شاشة التفعيل ===================== -->
<div id="actScreen">
  <div class="actbox">
    <button class="actClose" onclick="hideActivation()" aria-label="إغلاق">✕</button>
    <h2 id="actTitle">🔑 تفعيل التطبيق</h2>
    <p id="actText"></p>
    <div class="actTap blink">للتفعيل اضغط ⬇️</div>
    <button class="actReq" onclick="requestActivation()">📲 اضغط هنا لطلب التفعيل</button>
    <input id="licenseInput" placeholder="أدخلي مفتاح التفعيل هنا" maxlength="24" autocapitalize="characters" autocomplete="off">
    <button onclick="tryActivate()">تفعيل</button>
    <div class="actMsg" id="actMsg"></div>
    <div class="licList" id="licList"></div>
  </div>
</div>

<!-- ===================== شاشة اختيار المرحلة ===================== -->
<header>
  <button class="actbtn" id="actIcon" onclick="showActivation()" title="التفعيل">🔑</button>
  <button class="sideBtn supbtn" onclick="contactSupport()" title="الدعم التقني" aria-label="الدعم التقني">🎧</button>
  <button class="backbtn" id="stageBack" style="display:none" onclick="goStageHome()">→ رجوع</button>
  <button class="sideBtn sharebtn" onclick="shareApp()" title="مشاركة التطبيق" aria-label="مشاركة التطبيق">🔗</button>
  <img id="appLogo" src="img/logo.png" alt="Zad dz">
  <h1 id="mainTitle">Zad dz</h1>
  <p class="sub" id="mainSub">اختاري المرحلة الدراسية</p>
</header>
<div class="trialbar" id="trialBar"></div>

<div class="stageGrid" id="stageHome">
  <button class="stageBtn am" onclick="openStage('AM')">
    <span class="big">📘 التعليم المتوسط</span>
    <span class="small">من السنة الأولى إلى الرابعة متوسط — كامل</span>
  </button>
  <button class="stageBtn as" onclick="openStage('AS')">
    <span class="big">📙 التعليم الثانوي</span>
    <span class="small">الأولى والثانية والثالثة ثانوي — الشعب والروابط</span>
  </button>
  <div id="impBox"></div>
</div>

<div class="grid" id="home"></div>

<div id="asHome" style="display:none;max-width:480px;margin:auto">
  <div class="asNote">اختاري السنة ثم الشعبة لتصلي إلى الدروس والفروض والاختبارات. تُفتح الروابط في المتصفح.</div>
  <div class="grid" id="asGrid"></div>
</div>

<div id="asView" style="display:none;max-width:720px;margin:auto">
  <div class="top"><button onclick="closeAsView()">→ رجوع</button><h2 id="asVt"></h2></div>
  <div class="chips" id="asChips"></div>
  <div id="asSecs"></div>
</div>

<!-- ===================== شاشة المستوى: المواد + الروابط ===================== -->
<div id="view">
  <div class="top"><button onclick="goLevelsHome()">→ رجوع</button><h2 id="vt"></h2></div>

  <div class="subjgrid" id="subjGrid"></div>
  <div id="secs"></div>
</div>

<p class="note" id="foot"></p>

<!-- ===================== شاشة الدردشة مع الأستاذ المحلي ===================== -->
<div id="chat">
  <div class="chatTop"><button onclick="closeChat()">→ رجوع</button><h2 id="chatTitle"></h2></div>
  <div id="msgs"></div>
  <div id="topicBar"></div>
  <div class="chatIn">
    <input id="chatInput" placeholder="اكتبي سؤالك أو اسم الدرس..." onkeydown="if(event.key==='Enter')sendMsg()">
    <button onclick="sendMsg()">إرسال</button>
  </div>
</div>

<!-- ===================== شاشة الدروس والتمارين المحلية (📚) ===================== -->
<div id="lessonsScr">
  <div class="qTop"><button onclick="closeLessons()">→ رجوع</button><h2 id="lsTitle" style="margin:0;font-size:17px;flex:1"></h2></div>
  <input id="lsearch" type="search" placeholder="🔍 ابحثي باسم الدرس أو كلمة من الدرس...">
  <div class="lsTabs">
    <button id="lsTabLessons" class="on" onclick="lsSwitch('lessons')">📖 الدروس</button>
    <button id="lsTabEx" onclick="lsSwitch('exercises')">✏️ تمارين محلولة</button>
  </div>
  <div id="lsBody"></div>
</div>

<!-- ===================== شاشة المادة الموحّدة ===================== -->
<div id="hub">
  <div class="qTop"><button onclick="closeHub()">→ رجوع</button><h2 id="hubTitle" style="margin:0;font-size:18px;flex:1"></h2></div>
  <div id="hubBody"></div>
</div>

<!-- ===================== شاشة الكويز (📝) — تعتمد الذكاء الاصطناعي إن توفر مفتاح ===================== -->
<div id="quiz">
  <div class="qTop"><button onclick="closeQuiz()">→ رجوع</button><h2 id="quizTitle" style="margin:0;font-size:17px;flex:1"></h2></div>
  <div id="quizBody"></div>
</div>

<div id="webview">
  <div class="wvTop"><button onclick="closeWebview()">✕ إغلاق</button><span id="wvTitle"></span><button onclick="openExternal()">↗ فتح خارجي</button></div>
  <iframe id="wvFrame"></iframe>
</div>

<script src="db.js"></script>
<script src="license.js"></script>
<script src="lessons.js"></script>
<script src="lessons_3as_ge.js"></script>
<script src="lessons_3as_hgs.js"></script>
<script src="lessons_3as_hg.js"></script>
<script src="ar4_data.js"></script>
<script src="lessons_4am.js"></script>
<script src="m3_data.js"></script>
